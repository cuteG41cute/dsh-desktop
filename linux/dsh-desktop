    server_pid=$!
    started_by_us=1

    for _ in $(seq 1 60); do
        [ "$(probe)" = "200" ] && { running=1; break; }
        sleep 2
    done
    if [ "$running" != "1" ]; then
        echo "?????????DeepSeek Harness WebUI ????????????????????????$LOG_DIR/server.err.log" >&2

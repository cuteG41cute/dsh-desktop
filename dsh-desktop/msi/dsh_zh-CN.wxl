  <String Id="MaintenanceWelcomeDlgTitle" Overridable="yes" Value="{\WixUI_Font_Bigger}欢迎使用 [ProductName] 安装向导（v[ProductVersion]）" />
  <String Id="MaintenanceWelcomeDlgDescription" Overridable="yes" Value="通过安装向导可以更改在您的计算机上安装 [ProductName] v[ProductVersion] 功能的方式，或将其从您的计算机中删除。" />

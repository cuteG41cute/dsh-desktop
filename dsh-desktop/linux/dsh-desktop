#!/usr/bin/env bash
# ============================================================================
# DeepSeek Harness 桌面版（Linux）启动器
#   1. 检查依赖：python3-gi / WebKitGTK / node / npm / dsh，缺什么问一次就装什么。
#   2. 确保 WebUI 服务在运行：没运行就后台启动 `dsh web --no-open`。
#   3. 取得 Web 认证凭据：dsh ≥0.1.5 的 WebUI 需要一枚签名 cookie 才返回页面
#      （未认证时返回 401）。本脚本优先用 Harness home 里的持久签名密钥自行签发
#      cookie，并用真实请求验证其有效，再交给窗口注入；取不到时才退回
#      「dsh web 打印的带 token 认证 URL」方式。
#   4. 打开 WebKitGTK 原生窗口（多窗口 / 拖拽分离与 Windows 版一致）。
#   5. 窗口关闭后，若服务是本脚本启动的，则一并停止服务。
#
# 可用环境变量：
#   DSH_WEB_URL        打开的地址，默认 http://127.0.0.1:3080
#   DSH_BIN            dsh 的 lib/bin.js 路径（自动查找失败时手动指定）
#   DSH_NONINTERACTIVE=1  不询问直接按默认处理（缺 sudo 权限时避免卡住）
#
# 用法：dsh-desktop [--setup]     --setup 只装依赖，不开窗口
# ============================================================================
set -u

URL="${DSH_WEB_URL:-http://127.0.0.1:3080}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dsh-desktop"
LOG_DIR="$STATE_DIR/logs"
mkdir -p "$LOG_DIR"
# 本启动器所在的实例前缀（<prefix>/bin/dsh-desktop）。管理器启动的服务会把
# `dsh web: <带 token 的 URL>` 打印到 <prefix>/logs/web.log，取认证 URL 时要找这里。
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "$0")"
PREFIX="$(cd "$(dirname "$SELF")/.." 2>/dev/null && pwd || printf '')"
SETUP_ONLY=0
[ "${1:-}" = "--setup" ] && SETUP_ONLY=1

log() { echo "[dsh-desktop] $(date '+%H:%M:%S') $*"; }

# ---- 询问用户（非交互场合一律按「是」继续，避免 sudo 卡住） ----
ask() {
    if [ "${DSH_NONINTERACTIVE:-0}" = "1" ] || [ ! -t 0 ]; then
        return 0   # 无法询问时按同意处理；真正缺权限时会失败并给出提示
    fi
    local ans
    printf '%s [Y/n] ' "$1"
    read -r ans
    case "${ans:-y}" in
        y|Y|yes|YES|"") return 0 ;;
        *) return 1 ;;
    esac
}

# ---- 单实例锁：避免重复点图标时开出多套窗口/服务 ----
# flock 来自 util-linux，极简系统上可能没有（实测有发行版连 procps/curl 都缺）。
# 没有 flock 时退化成「mkdir 原子锁 + pid 存活检查」，绝不因为缺工具就静默退出。
LOCK="/tmp/dsh-desktop.lock"
if [ "${DSH_DESKTOP_FORCE:-0}" = "1" ]; then
    log "DSH_DESKTOP_FORCE=1：跳过单实例检查，强制启动一个窗口。"
elif command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK"
    if ! flock -n 9; then
        holder="$(cat "$LOCK.pid" 2>/dev/null || true)"
        log "已有另一个 DeepSeek Harness 桌面窗口在运行${holder:+（PID $holder）}，本次直接退出。"
        log "   → 若那个窗口其实没出现：kill ${holder:-<PID>}（或 pkill -f share/dsh-desktop）"
        log "   → 或强制再开一个：DSH_DESKTOP_FORCE=1 dsh-desktop"
        exit 0
    fi
    printf '%s' "$$" > "$LOCK.pid" 2>/dev/null || true
else
    LOCK_DIR="/tmp/dsh-desktop.lock.d"
    mkdir -p "$LOCK_DIR" 2>/dev/null || true
    held=1
    if mkdir "$LOCK_DIR/held" 2>/dev/null; then
        held=0
    else
        old="$(cat "$LOCK_DIR/held/pid" 2>/dev/null || true)"
        if [ -n "${old:-}" ] && kill -0 "$old" 2>/dev/null; then
            log "已有另一个 DeepSeek Harness 桌面窗口在运行（PID $old），本次直接退出。"
            log "   → 结束它：kill $old ／ 或强制再开：DSH_DESKTOP_FORCE=1 dsh-desktop"
            exit 0
        fi
        rm -rf "$LOCK_DIR/held" 2>/dev/null || true
        mkdir "$LOCK_DIR/held" 2>/dev/null && held=0
    fi
    if [ "$held" = "0" ]; then
        printf '%s' "$$" > "$LOCK_DIR/held/pid" 2>/dev/null || true
        trap 'rm -rf "$LOCK_DIR/held" 2>/dev/null || true' EXIT
    else
        log "拿不到单实例锁（$LOCK_DIR），继续启动；若开出多个窗口请手动关掉多余的。"
    fi
fi

# ============================================================================
# 依赖检查
# ============================================================================

# python3-gi + WebKitGTK：缺了就没有窗口，用 sudo 装（deepin 20 上是 4.0）
ensure_py_gi() {
    if python3 -c "import gi; gi.require_version('Gtk','3.0'); gi.require_version('WebKit2','4.1')" 2>/dev/null; then
        return 0
    fi
    if python3 -c "import gi; gi.require_version('Gtk','3.0'); gi.require_version('WebKit2','4.0')" 2>/dev/null; then
        return 0
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        echo "缺少 python3，无法启动桌面窗口。请先安装：sudo apt install python3" >&2
        return 1
    fi
    echo "缺少 GTK/WebKitGTK 的 Python 绑定（python3-gi + WebKitGTK）。"
    if ask "是否现在用 sudo 通过 apt-get 安装？（需要管理员密码）"; then
        # 先试 4.1（新系统），deepin 20 等旧系统退回 4.0
        if sudo apt-get install -y python3-gi gir1.2-webkit2-4.1 2>/dev/null; then
            return 0
        fi
        sudo apt-get install -y python3-gi gir1.2-webkit2-4.0 2>/dev/null && return 0
        echo "安装失败，请手动执行其中一条：" >&2
        echo "  sudo apt install python3-gi gir1.2-webkit2-4.1   # deepin 20 用 gir1.2-webkit2-4.0" >&2
        return 1
    fi
    return 1
}

# 检查 node（dsh 需要 Node 18+）
# 注意：**不再自己往系统/用户目录装 Node**。便携安装由 install.sh 负责（node 在安装前缀里），
# 启动器只在 PATH 里找不到时明确报错，避免"装了但装到不知道的地方去"。
node_ok() {
    command -v node >/dev/null 2>&1 || return 1
    local major
    major="$(node -v 2>/dev/null | tr -d 'v' | cut -d. -f1)"
    [ -n "$major" ] && [ "$major" -ge 18 ]
}

ensure_node() {
    node_ok && return 0
    cat >&2 <<'EOS'
未找到可用的 Node.js（dsh 需要 Node 18+）。

本版桌面程序**不再自动安装 Node**（避免装到系统里/用户不知道的位置）。
请用便携安装器装一次，它会把 Node 放进你指定的安装目录：

    bash linux/install.sh --prefix <安装目录>

或把你自己的 node 加进 PATH 后重试。
EOS
    return 1
}

# npm 全局目录不可写时，改用 ~/.npm-global（避免 sudo 装包）
ensure_npm_prefix() {
    command -v npm >/dev/null 2>&1 || return 1
    local prefix
    prefix="$(npm config get prefix 2>/dev/null)"
    if [ -n "$prefix" ] && [ ! -w "$prefix" ]; then
        mkdir -p "$HOME/.npm-global"
        npm config set prefix "$HOME/.npm-global" >/dev/null 2>&1 || true
        export PATH="$HOME/.npm-global/bin:$PATH"
    fi
}

find_dsh() {
    local d g home
    # 0) 手动指定：DSH_BIN 指向 dsh 的 lib/bin.js
    if [ -n "${DSH_BIN:-}" ]; then
        if [ -f "$DSH_BIN" ]; then printf '%s' "$DSH_BIN"; return 0; fi
        echo "警告：DSH_BIN 指向的文件不存在：$DSH_BIN" >&2
    fi
    # 1) npx 缓存（npx @deepseek-ai/dsh 跑过一次就会有）
    for d in "$HOME/.npm/_npx"/*/node_modules/@deepseek-ai/dsh/lib/bin.js; do
        [ -f "$d" ] && { printf '%s' "$d"; return 0; }
    done
    g="$(npm prefix -g 2>/dev/null)/node_modules/@deepseek-ai/dsh/lib/bin.js"
    [ -f "$g" ] && { printf '%s' "$g"; return 0; }
    if command -v dsh >/dev/null 2>&1; then printf 'dsh'; return 0; fi
    home="${DSH_HOME:-$HOME/.dsh}"
    [ -f "$home/profiles/web/node_modules/@deepseek-ai/dsh/lib/bin.js" ] && {
        printf '%s' "$home/profiles/web/node_modules/@deepseek-ai/dsh/lib/bin.js"; return 0
    }
    return 1
}

# 没装 dsh 就明确报错并指向便携安装器（**不再 npm -g**，避免全局安装）
ensure_dsh() {
    find_dsh >/dev/null 2>&1 && return 0
    cat >&2 <<'EOS'
未找到 DeepSeek Harness（dsh）。

本版桌面程序**不再用 npm -g 全局安装**。请用便携安装器装一次：

    bash linux/install.sh --prefix <安装目录>

或者把 DSH_BIN 指向你自己的 dsh 的 lib/bin.js：
    export DSH_BIN=/path/to/@deepseek-ai/dsh/lib/bin.js
EOS
    return 1
}

# ---- 探测 WebUI：旧版 dsh 直接 200；≥0.1.5 未认证时返回 401（正文是 dsh 的提示） ----
# 只用 python3（窗口本身也要它），**不依赖 curl**：实测某些发行版根本没装 curl，
# 那时 curl 调用返回空 → 误判「服务没起」→ 去抢端口 → 窗口永远出不来。
http_code() {  # $1=url → 打印状态码；连不上打印 000
    python3 - "$1" <<'PY' 2>/dev/null
import sys, urllib.request, urllib.error
url = sys.argv[1]
try:
    with urllib.request.urlopen(url, timeout=3) as r:
        print(r.status)
except urllib.error.HTTPError as e:
    print(e.code)
except Exception:
    print('000')
PY
}

http_body() {  # $1=url → 打印正文前 2000 字符（含 4xx 的正文）
    python3 - "$1" <<'PY' 2>/dev/null
import sys, urllib.request, urllib.error
url = sys.argv[1]
try:
    with urllib.request.urlopen(url, timeout=3) as r:
        print(r.read(2000).decode('utf-8', 'replace'))
except urllib.error.HTTPError as e:
    try:
        print(e.read(2000).decode('utf-8', 'replace'))
    except Exception:
        pass
except Exception:
    pass
PY
}

probe() { http_code "$URL/"; }

# 401 可能是「dsh 在运行但需要认证」，也可能是别的服务占用端口，用正文区分。
webui_running() {
    local code
    code="$(probe)"
    [ "$code" = "200" ] && return 0
    if [ "$code" = "401" ]; then
        http_body "$URL/" | grep -q 'dsh web authentication required'
        return
    fi
    return 1
}

# 用一枚 cookie 做真实请求，验证服务端是否接受（200 = 接受）
verify_cookie() {  # $1=cookie
    python3 - "$URL/" "$1" <<'PY' 2>/dev/null
import sys, urllib.request, urllib.error
url, cookie = sys.argv[1], sys.argv[2]
req = urllib.request.Request(url, headers={'Cookie': cookie})
try:
    with urllib.request.urlopen(req, timeout=5) as r:
        print(r.status)
except urllib.error.HTTPError as e:
    print(e.code)
except Exception:
    print('000')
PY
}

find_node_cmd() {
    if command -v node >/dev/null 2>&1; then printf 'node'; return 0; fi
    [ -x "$HOME/.local/bin/node" ] && { printf '%s' "$HOME/.local/bin/node"; return 0; }
    return 1
}

# ---- Web 认证：自行签发 cookie 并用真实请求验证 ----
# dsh 让浏览器用「每个进程随机的一次性 token」换取一枚长期签名 cookie。token 只在
# 服务进程内，外部推导不出来；但签名密钥是持久的（每个 Harness home 一份，存在
# $DSH_HOME/.credentials.yaml 的 client-connection/browser-session 记录里），cookie
# 格式也是确定的：
#   cookie 名 = "dsh-auth-" + base64url(sha256(authority))
#   cookie 值 = "v1." + base64url(payload) + "." + base64url(HMAC-SHA256(secret, payload))
#   payload   = {"version":1,"authority":"host:port","issuedAt":ms,"expiresAt":ms}
# 所以本脚本可以自己签发一枚 cookie，再用一次真实请求确认服务端接受它。这样即使
# WebUI 是用户在别处手动启动的（读不到 token 日志），窗口也能正常认证。
# 若将来 dsh 改了密钥存放或 cookie 格式，验证会失败，脚本自动退回认证 URL 方式。
mint_cookie() {
    DSH_AUTH_URL="$URL" DSH_AUTH_DAYS="${1:-30}" python3 - <<'PYEOF' 2>/dev/null
import base64, hashlib, hmac, json, os, re, time, urllib.parse

url = os.environ.get('DSH_AUTH_URL', 'http://127.0.0.1:3080')
days = int(os.environ.get('DSH_AUTH_DAYS', '30'))
home = os.environ.get('DSH_HOME') or os.path.join(os.path.expanduser('~'), '.dsh')
try:
    text = open(os.path.join(home, '.credentials.yaml'), encoding='utf-8').read()
except OSError:
    raise SystemExit(0)

m = re.search(r'client-connection/browser-session:.*?secret:\s*([A-Za-z0-9_\-]+)', text, re.S)
if not m:
    raise SystemExit(0)
raw = m.group(1)
secret = base64.urlsafe_b64decode(raw + '=' * (-len(raw) % 4))
if len(secret) != 32:
    raise SystemExit(0)

authority = urllib.parse.urlsplit(url).netloc
b64 = lambda b: base64.urlsafe_b64encode(b).decode().rstrip('=')
name = 'dsh-auth-' + b64(hashlib.sha256(authority.encode()).digest())
now = int(time.time() * 1000)
payload = json.dumps({'version': 1, 'authority': authority,
                      'issuedAt': now, 'expiresAt': now + days * 86400000},
                     separators=(',', ':'))
body = b64(payload.encode())
print('%s=v1.%s.%s' % (name, body, b64(hmac.new(secret, body.encode(), hashlib.sha256).digest())))
PYEOF
}

# 从各处的日志里找 `dsh web: <带 token 的 URL>`。服务可能是本脚本启动的
# （-> $LOG_DIR/server.out.log），也可能是管理器/用户自己启动的
# （-> $PREFIX/logs/web.log）。两处都要看，否则窗口只拿到裸地址，会被要求认证。
find_auth_url() {
    local f a
    for f in "$LOG_DIR/server.out.log" \
             "${PREFIX:-/nonexistent}/logs/web.log" \
             "${PREFIX:-/nonexistent}/logs/server.out.log" \
             "${PREFIX:-/nonexistent}/logs/desktop.log"; do
        [ -f "$f" ] || continue
        a="$(grep -o 'dsh web: https\?://[^ ]*' "$f" 2>/dev/null | tail -n 1 | sed 's/^dsh web: //')"
        if [ -n "$a" ]; then
            printf '%s' "$a"
            return 0
        fi
    done
    return 1
}

# 解析认证方式：0 = cookie 已验证（走环境变量交给窗口注入）
#             1 = 只有认证 URL（WINDOW_URL 已替换）
#             2 = 都没有（照旧打开原地址）
resolve_auth() {
    local cookie code days
    # 有效期不能超过服务端配置（默认 cookieMaxAgeDays = 30），按 30/7/1 天依次试
    for days in 30 7 1; do
        cookie="$(mint_cookie "$days" || true)"
        [ -n "$cookie" ] || break
        # 必须用真实请求验证：cookie 名/值任一不对都会拿到 401
        code="$(verify_cookie "$cookie")"
        if [ "$code" = "200" ]; then
            export DSH_DESKTOP_AUTH_COOKIE="$cookie"
            export DSH_DESKTOP_AUTH_COOKIE_MAXAGE=$((days * 86400))
            return 0
        fi
    done

    local auth
    auth="$(find_auth_url || true)"
    if [ -n "$auth" ]; then
        WINDOW_URL="$auth"
        return 1
    fi
    return 2
}

# ============================================================================
# 主流程
# ============================================================================

log "DeepSeek Harness 桌面版（Linux）"

ensure_py_gi || exit 1
ensure_node || exit 1
ensure_dsh || exit 1

if [ "$SETUP_ONLY" = "1" ]; then
    log "依赖检查完成（python3-gi / Node.js / dsh 均已就绪）。"
    exit 0
fi

NODE="$(find_node_cmd || true)"
DSH="$(find_dsh || true)"

# ---- 1. 确保服务在运行 ----
started_by_us=0
server_pid=""
running=0
webui_running && running=1

if [ "$running" != "1" ]; then
    port="${URL##*:}"
    port="${port%%/*}"
    [ -z "$port" ] && port=3080

    log "正在启动 dsh web 服务（端口 $port）…"
    # --no-open：新版 dsh web 默认会打开系统浏览器，桌面版自己开窗，必须禁用
    if [ "$DSH" = "dsh" ]; then
        nohup "$NODE" "$(readlink -f "$(command -v dsh)")" web --no-open --port "$port" \
            >"$LOG_DIR/server.out.log" 2>"$LOG_DIR/server.err.log" &
    else
        nohup "$NODE" "$DSH" web --no-open --port "$port" \
            >"$LOG_DIR/server.out.log" 2>"$LOG_DIR/server.err.log" &
    fi
    server_pid=$!
    started_by_us=1

    for _ in $(seq 1 60); do
        webui_running && { running=1; break; }
        sleep 2
    done
    if [ "$running" != "1" ]; then
        echo "错误：DeepSeek Harness WebUI 未能启动，详情见 $LOG_DIR/server.err.log" >&2
        kill "$server_pid" 2>/dev/null
        exit 1
    fi
    log "服务已就绪。"
else
    log "服务已在运行，直接打开窗口。"
fi

# ---- 2. 认证凭据 ----
WINDOW_URL="$URL"
resolve_auth
case "$?" in
    0) log "已签发并验证 Web 认证 cookie，窗口将直接认证。" ;;
    1) log "已获取认证 URL，窗口将自动完成 Web 认证。" ;;
    *) log "未取得认证凭据；若窗口提示需要认证，请用 dsh web 打印的带 token 地址打开一次。" ;;
esac

# ---- 3. 打开原生窗口（阻塞直到窗口关闭） ----
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"   # readlink -f：兼容 ~/.local/bin 下的软链接
PY=""
if [ -f "$SCRIPT_DIR/dsh-desktop.py" ]; then
    PY="$SCRIPT_DIR/dsh-desktop.py"
elif command -v dsh-desktop-py >/dev/null 2>&1; then
    PY="$(command -v dsh-desktop-py)"
fi
if [ -z "$PY" ]; then
    echo "错误：找不到 dsh-desktop.py（应在 $SCRIPT_DIR/dsh-desktop.py）" >&2
    if [ "$started_by_us" = "1" ]; then kill "$server_pid" 2>/dev/null; fi
    exit 1
fi

# ---- 软件渲染兜底 ----
# 没有可用 GPU 时 WebKit 拿不到 GL 上下文 → 窗口白屏 / 只画出一部分（实测：Wayland 下
# 上半截是一块没画过的灰板）。判据不能只看 /dev/dri 存不存在：Hyper-V/KVM 的虚拟机里
# /dev/dri 常常是 virtio_gpu，而 MESA 会报
#   libEGL warning: failed to get driver name for fd -1
#   MESA: error: ZINK: failed to choose pdev
#   libEGL warning: egl: failed to create dri2 screen
# 这种情况必须走软件渲染，否则整窗重绘永远不完整。
# 判据（两者任一成立就关合成）：
#   1) /dev/dri 不存在；
#   2) DRM 驱动是虚拟/半虚拟显卡（virtio_gpu / vmwgfx / qxl / bochs / vboxvideo / vkms）。
# 还可以用 DSH_DESKTOP_GL=on/off 强制覆盖；窗口程序内部还会再做一次 GL 上下文探测。
# 判据这段（GL_POLICY_BEGIN/END 之间）由 tools/gl-detect-check.py 直接抽出来跑，
# 所以路径用 DEV_DRI / SYSFS_DRM 变量（默认就是真实路径），测试里指到临时目录。
GL_MODE="${DSH_DESKTOP_GL:-auto}"
DEV_DRI="${DEV_DRI:-/dev/dri}"
SYSFS_DRM="${SYSFS_DRM:-/sys/class/drm}"
# ---- GL_POLICY_BEGIN ----
dri_driver() {
    local p
    for p in "$SYSFS_DRM"/card*/device/driver; do
        [ -e "$p" ] || continue
        basename "$(readlink -f "$p")"
        return 0
    done
    return 1
}
# DRM_DRIVER 可以直接指定驱动名（判据测试与排障时用，跳过 sysfs 探测）
if [ -n "${DRM_DRIVER:-}" ]; then
    DRV="$DRM_DRIVER"
else
    DRV="$(dri_driver 2>/dev/null || true)"
fi
VIRT_DRV=0
case "$DRV" in
    virtio_gpu|virtio-gpu|vmwgfx|qxl|bochs|vboxvideo|vkms|simpledrm) VIRT_DRV=1 ;;
esac
SOFT_REASON=""
if [ "$GL_MODE" = "off" ]; then
    SOFT_REASON="DSH_DESKTOP_GL=off"
elif [ "$GL_MODE" = "auto" ]; then
    if [ ! -e "$DEV_DRI" ]; then
        SOFT_REASON="/dev/dri 不存在"
    elif [ "$VIRT_DRV" = "1" ]; then
        SOFT_REASON="检测到虚拟显卡驱动 ${DRV:-未知}（这类驱动通常给不出可用的 GL）"
    fi
fi
# ---- GL_POLICY_END ----
if [ -n "$SOFT_REASON" ]; then
    export WEBKIT_DISABLE_COMPOSITING_MODE=1
    export LIBGL_ALWAYS_SOFTWARE=1
    log "改用软件渲染：$SOFT_REASON。"
else
    log "使用 GPU 渲染（DRM 驱动：${DRV:-未知}）。若窗口出现空白/只画出一部分，用 DSH_DESKTOP_GL=off 重启。"
fi

log "正在打开桌面窗口: $WINDOW_URL"
DSH_WEB_URL="$URL" python3 "$PY" "$WINDOW_URL"
win_exit=$?

# ---- 4. 窗口关闭后清理（只停本脚本启动的服务） ----
if [ "$started_by_us" = "1" ] && [ -n "$server_pid" ] && kill -0 "$server_pid" 2>/dev/null; then
    log "桌面窗口已关闭，停止 dsh 服务…"
    kill "$server_pid" 2>/dev/null
    sleep 1
    kill -9 "$server_pid" 2>/dev/null
fi
log "完成。"
exit "$win_exit"

/* ============================================================================
 * DeepSeek Harness 管理器 · GTK 主题模板
 *
 * 本文件不是直接用的：tools/build-gtk-theme.py 把下面这些占位符替换成
 * design/styles.css 里抽出来的令牌，生成 dsh_manager/theme/<主题>-<日/夜>.css。
 * 占位符：
 *   $(bg) $(bg2) $(app) $(sidebar) $(topbar) $(card) $(card-solid) $(text)
 *   $(muted) $(subtle) $(border) $(inner-border) $(accent) $(accent2)
 *   $(accent-rgb) $(accent-soft) $(on-accent) $(hover) $(success) $(danger)
 *   $(radius) $(app-radius) $(shadow) $(card-shadow) $(bg-image)
 *
 * 与设计稿的对应关系写在每段的注释里，方便以后对照检查。
 * GTK3 的 CSS 没有 backdrop-filter / CSS 变量 / flex：透明面板叠在
 * 预先渲染好的背景图（$(bg-image)）上，视觉上等价。
 * ========================================================================== */

/* ---------- 系统主题重置 ----------
 * GTK 的默认主题会给 button 画底色/渐变/内阴影；设计稿只有 hover 与选中态才有底色。
 * 不重置的话，暗色主题整片偏亮（实测 alpine-night 侧栏 +14 色阶）。 */
button {
  background-image: none;
  border-image: none;
  box-shadow: none;
  text-shadow: none;
}
.side-link,
.new-instance,
.instance-item,
.text-btn,
.log-view,
.row-flat {
  background-color: transparent;
  box-shadow: none;
}
.side-link.selected,
.side-link:selected,
.instance-item:selected,
.instance-item.active {
  background-color: $(hover);
}

/* ---------- 动效 ----------
 * GTK3 的 transition 只支持少数属性（颜色/背景/边框/阴影），但它们正是设计稿里
 * hover、选中、切换那些观感的来源。transform / backdrop-filter 这类 GTK 不支持，
 * 所以 hover 的"上浮"用阴影变化代替。 */
button, .btn, .side-link, .instance-item, .quick-action, .icon-btn,
.theme-trigger, .mode-toggle, .new-instance,
popover modelbutton, popover button.flat {
  transition: background-color 160ms ease-out,
              color 160ms ease-out,
              border-color 160ms ease-out,
              box-shadow 160ms ease-out;
}

/* ---------- 窗口：设计稿 body 的渐变 + .scene 背景 ---------- */
window.dsh-window,
.dsh-window {
  background-image: $(bg-image);
  background-size: cover;
  background-color: $(bg);
  color: $(text);
  font-family: "Segoe UI", "Noto Sans CJK SC", "Microsoft YaHei UI", sans-serif;
  font-size: 11px;
}

/* 应用外壳：app-shell（圆角 + 外阴影 + 半透明） */
.dsh-shell {
  background-color: $(app);
  border: 1px solid $(border);
  border-radius: $(app-radius);
  box-shadow: $(shadow);
}

/* ---------- 侧栏 ---------- */
.sidebar {
  background-color: $(sidebar);
  border-right: 1px solid $(inner-border);
  padding: 22px 14px 16px;
  border-top-left-radius: $(app-radius);
  border-bottom-left-radius: $(app-radius);
}

/* brand-mark: 38×38 渐变方块 + 内圈高光 */
.brand-mark {
  min-width: 38px;
  min-height: 38px;
  border-radius: 12px;
  background-image: linear-gradient(140deg, $(accent2), $(accent));
  color: $(on-accent);
  font-size: 19px;
  font-weight: 750;
  box-shadow: 0 7px 18px alpha($(accent), .25);
}
.brand-title { font-size: 13px; font-weight: 750; color: $(text); }
.brand-sub { font-size: 11px; color: $(muted); }

/* side-section-title / count */
.side-section-title { color: $(muted); font-size: 11px; font-weight: 600; }
.count-pill {
  background-color: $(accent-soft);
  color: $(accent);
  border-radius: 10px;
  padding: 1px 6px;
  font-size: 10px;
  font-weight: 600;
}

/* instance-item：61px 高、13px 圆角、选中态 hover + 内边框 */
.instance-list { background: transparent; }
.instance-item {
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 13px;
  padding: 8px 10px;
}
.instance-item:hover { background-color: $(hover); }
.instance-item.active {
  background-color: $(hover);
  border-color: $(inner-border);
  box-shadow: $(card-shadow);
}
.instance-avatar {
  min-width: 34px;
  min-height: 34px;
  border-radius: 10px;
  background-color: $(accent-soft);
  color: $(accent);
  font-size: 10px;
  font-weight: 750;
}
.instance-item.active .instance-avatar {
  background-image: linear-gradient(140deg, $(accent2), $(accent));
  color: $(on-accent);
  box-shadow: 0 5px 12px alpha($(accent), .18);
}
.instance-name { font-size: 12px; font-weight: 600; color: $(text); }
.instance-sub { font-size: 10px; color: $(muted); }

/* status-dot：7px 圆点（用 label 画） */
.status-dot {
  min-width: 7px;
  min-height: 7px;
  border-radius: 999px;
  background-color: $(success);
}
.status-dot.stopped { background-color: $(subtle); }

/* new-instance：虚线框 */
.new-instance {
  border: 1px dashed $(inner-border);
  border-radius: 11px;
  background-color: transparent;
  color: $(muted);
  font-size: 11px;
  min-height: 38px;
}
.new-instance:hover {
  border-color: alpha($(accent), .45);
  background-color: $(accent-soft);
  color: $(accent);
}

/* side-caption / side-link / runtime 卡片 */
.side-caption { color: $(subtle); font-size: 10px; font-weight: 600; }
.side-link {
  border-radius: 10px;
  background-color: transparent;
  color: $(muted);
  font-size: 12px;
  min-height: 40px;
  padding: 0 11px;
}
.side-link:hover { background-color: $(hover); color: $(text); }
.side-link.selected { background-color: $(hover); color: $(accent); font-weight: 600; }
.runtime {
  border: 1px solid $(inner-border);
  border-radius: 12px;
  background-color: $(card);
  padding: 12px 10px;
}
.runtime-icon {
  min-width: 28px;
  min-height: 28px;
  border-radius: 8px;
  background-color: $(accent-soft);
  color: $(accent);
  font-size: 9px;
  font-weight: 700;
}
.runtime-title { font-size: 10px; font-weight: 600; color: $(text); }
.runtime-sub { font-size: 9px; color: $(muted); }

/* ---------- 顶栏 ---------- */
.topbar {
  background-color: $(topbar);
  border-bottom: 1px solid $(inner-border);
  padding: 0 30px;                 /* 设计稿 .topbar{padding:0 30px} */
  /* 设计稿 66px = 内容 65 + 1px 下边框；这里 min-height 只算内容盒，写 65 会多出 1px，
     把整个内容区往下推（实测所有元素 +1.8px 的来源）。 */
  min-height: 65px;
  border-top-right-radius: $(app-radius);
}
.breadcrumb { color: $(muted); font-size: 11px; }
.breadcrumb-current { color: $(text); font-weight: 600; font-size: 11px; }

/* theme-trigger（设计稿 .theme-trigger：34px、10px 圆角、卡片底） */
.theme-trigger {
  border: 1px solid $(inner-border);
  border-radius: 10px;
  background-color: $(card);
  color: $(text);
  font-size: 11px;
  font-weight: 600;
  min-height: 34px;
  padding: 0 10px;
}
.theme-swatch {
  min-width: 14px;
  min-height: 14px;
  border-radius: 5px;
  background-image: linear-gradient(135deg, $(accent2), $(accent));
}
.mode-toggle {
  border: 1px solid $(inner-border);
  border-radius: 16px;
  background-color: $(card);
  color: $(muted);
  min-height: 30px;
  min-width: 57px;
  padding: 0 8px;
}
.mode-toggle:hover { color: $(text); }

/* ---------- 页面标题 ---------- */
.eyebrow { color: $(accent); font-size: 9px; font-weight: 750; }
.page-title { font-size: 25px; font-weight: 680; color: $(text); }
.page-desc { font-size: 11px; color: $(muted); }

/* 状态徽标：圆角胶囊 + 半透明成功色 */
.badge {
  border-radius: 12px;
  padding: 3px 9px;
  font-size: 9px;
  font-weight: 600;
  border: 1px solid $(inner-border);
  background-color: $(accent-soft);
  color: $(muted);
}
.badge.running {
  color: $(success);
  background-color: alpha($(success), .09);
  border-color: alpha($(success), .18);
}
.badge.needs-repair {
  color: $(danger);
  background-color: alpha($(danger), .1);
  border-color: alpha($(danger), .2);
}

/* ---------- 卡片 ---------- */
.card {
  background-color: $(card);
  border: 1px solid $(border);
  border-radius: $(radius);
  box-shadow: $(card-shadow);
  padding: 18px 20px;   /* 设计稿 .card: 18px 20px */
}
.card-label { font-size: 11px; font-weight: 650; color: $(text); }
.card-sub { font-size: 9px; color: $(muted); }
.subtle-tag {
  border-radius: 6px;
  background-color: $(accent-soft);
  color: $(muted);
  font-size: 8px;   /* 设计稿 .subtle-tag */
  padding: 3px 7px;
}
.large-avatar {
  min-width: 48px;
  min-height: 48px;
  border-radius: 14px;
  background-image: linear-gradient(145deg, $(accent2), $(accent));
  color: $(on-accent);
  font-size: 14px;
  font-weight: 700;
  box-shadow: 0 7px 17px alpha($(accent), .18);
}
.meta-name { font-size: 13px; font-weight: 650; color: $(text); }
.meta-path {
  font-family: Consolas, "DejaVu Sans Mono", monospace;
  font-size: 9px;
  color: $(muted);
}
.version-pill {
  border: 1px solid $(inner-border);
  border-radius: 6px;
  color: $(muted);
  font-size: 8px;   /* 设计稿 .version-pills span */
  padding: 3px 7px;
}
.metric-label { font-size: 8.5px; color: $(muted); }
.metric-value { font-size: 12px; font-weight: 650; color: $(text); }
.metric-value.accent { color: $(success); }
.control-title { font-size: 11px; font-weight: 600; color: $(text); }
.control-sub { font-size: 8.5px; color: $(muted); }
.control-separator { border-top: 1px solid $(inner-border); }

/* ---------- 按钮 ---------- */
.btn {
  border-radius: 11px;
  border: 1px solid transparent;
  font-size: 11px;
  font-weight: 600;
  min-height: 36px;
  padding: 0 15px;   /* 设计稿 .btn: 38px border-box */
}
.btn-primary {
  background-image: linear-gradient(135deg, $(accent2), $(accent));
  color: $(on-accent);
  border-color: transparent;
  box-shadow: 0 7px 16px alpha($(accent), .2);
}
.btn-primary:hover {
  box-shadow: 0 9px 22px alpha($(accent), .28);
}
.btn-secondary {
  border-color: $(inner-border);
  background-color: $(card);
  color: $(text);
  box-shadow: $(card-shadow);
}
.btn-secondary:hover { background-color: $(hover); }
.btn-danger-soft {
  border-color: alpha($(danger), .18);
  background-color: alpha($(danger), .07);
  color: $(danger);
}
.btn-danger-soft:hover { background-color: alpha($(danger), .12); }
.btn.compact { min-height: 31px; font-size: 9px; padding: 0 10px; border-radius: 9px; }
.btn-icon { min-width: 38px; padding: 0; }
.text-btn {
  background: transparent;
  border: none;
  box-shadow: none;
  color: $(accent);
  font-size: 9px;
  font-weight: 550;
  padding: 0;
  min-height: 22px;
}
.text-btn:hover { color: $(accent2); }

/* icon-btn：36×36 透明按钮 */
.icon-btn {
  background-color: transparent;
  border: none;
  box-shadow: none;
  border-radius: 10px;
  color: $(muted);
  min-width: 36px;
  min-height: 36px;
  padding: 0;
}
.icon-btn:hover { background-color: $(hover); color: $(text); }
.icon-btn.small { min-width: 25px; min-height: 25px; border-radius: 8px; }

/* ---------- 常用功能 ---------- */
.quick-action {
  background-color: $(card);
  border: 1px solid $(border);
  border-radius: 15px;
  box-shadow: $(card-shadow);
  padding: 13px;
  min-height: 54px;   /* 设计稿 82px(border-box) */
}
.quick-action:hover {
  background-color: $(hover);
  border-color: alpha($(accent), .25);
}
.quick-icon {
  min-width: 34px;
  min-height: 34px;
  border-radius: 10px;
  background-color: $(accent-soft);
  color: $(accent);
}
.quick-title { font-size: 10.5px; font-weight: 600; color: $(text); }
.quick-sub { font-size: 8px; color: $(muted); }
.section-title { font-size: 12px; font-weight: 650; color: $(text); }
.section-sub { font-size: 9px; color: $(muted); }

/* ---------- 日志卡 ---------- */
.log-header { min-height: 45px; padding: 0 18px; border-bottom: 1px solid $(inner-border); }
.log-title { font-size: 12px; font-weight: 650; color: $(text); }
.log-count {
  border-radius: 8px;
  background-color: $(accent-soft);
  color: $(muted);
  font-size: 9px;
  padding: 1px 6px;
}
.log-line {
  font-family: Consolas, "DejaVu Sans Mono", monospace;
  font-size: 8.5px;
  min-height: 27px;
  color: $(text);
}
.log-time { color: $(subtle); }
.log-level {
  border-radius: 4px;
  padding: 1px 5px;
  font-family: "Segoe UI", sans-serif;
  font-size: 8px;
  background-color: $(accent-soft);
  color: $(muted);
}
.log-level.success { color: $(success); background-color: alpha($(success), .09); }
.log-level.info { color: $(accent); }
.log-view {
  background-color: transparent;
  color: $(text);
  font-family: Consolas, "DejaVu Sans Mono", monospace;
  font-size: 9px;
}
.log-view text { background-color: transparent; color: $(text); }
.page-footer { color: $(subtle); font-size: 8px; padding-top: 12px; }

/* ---------- 输入控件 ---------- */
entry, spinbutton, .entry {
  background-color: $(card);
  border: 1px solid $(inner-border);
  border-radius: 10px;
  color: $(text);
  min-height: 34px;
  padding: 0 8px;
}
entry:focus, spinbutton:focus { border-color: alpha($(accent), .5); }
spinbutton button { min-height: 30px; min-width: 28px; }
combobox button, menubutton button.combo {
  background-color: $(card);
  border: 1px solid $(inner-border);
  border-radius: 10px;
  color: $(text);
  min-height: 34px;
  padding: 0 8px;
}
label.field-label { font-size: 10px; font-weight: 600; color: $(text); }
label.field-hint { font-size: 9px; color: $(muted); }

/* ---------- 弹层（主题菜单 / 更多菜单 / 设置页） ---------- */
popover {
  background-color: $(card-solid);
  border: 1px solid $(border);
  border-radius: 14px;
  box-shadow: 0 18px 45px alpha($(text), .18);
}
popover modelbutton, popover button.flat {
  border-radius: 9px;
  color: $(text);
  font-size: 11px;
  min-height: 34px;
  padding: 0 10px;
  background-color: transparent;
}
popover modelbutton:hover, popover button.flat:hover { background-color: $(accent-soft); }
popover label.menu-header { color: $(muted); font-size: 10px; padding: 6px 9px; }

dialog {
  background-color: $(card-solid);
  border: 1px solid $(border);
  border-radius: 16px;
  color: $(text);
}
dialog .dialog-title { font-size: 14px; font-weight: 650; }

/* 滚动区 / 滚动条：细、低对比 */
scrolledwindow, viewport { background-color: transparent; }
scrollbar { background-color: transparent; border: none; }
scrollbar slider {
  background-color: alpha($(text), .16);
  border-radius: 8px;
  min-width: 6px;
  min-height: 24px;
}
scrollbar slider:hover { background-color: alpha($(text), .26); }
separator { background-color: $(inner-border); min-width: 1px; min-height: 1px; }
tooltip {
  background-color: $(card-solid);
  color: $(text);
  border: 1px solid $(border);
  border-radius: 8px;
}
/* ==========================================================================
 * 第二轮保真修正（1.3.2）
 *  - GTK3 的 label 不画背景：所有"色块/圆点/药丸"改用 Gtk.EventBox + .chip
 *  - ListBox 的 :selected 会被系统主题染成蓝色：这里强制回设计稿的 hover 态
 *  - 滚动条按设计稿收细、去底色
 * ========================================================================== */

.chip { background-color: transparent; }
.chip label { background-color: transparent; }

/* 药丸：内边距放在 EventBox 上（里面的 label 只负责文字） */
.count-pill { padding: 1px 6px; }
.version-pill { padding: 2px 7px; }
.subtle-tag { padding: 2px 7px; }
.badge { padding: 3px 9px; }
.log-level { padding: 1px 5px; }
.live-indicator { padding: 0; font-size: 8.5px; }   /* 设计稿：无内边距，只有颜色 */
.theme-dot { border-radius: 4px; }

/* 选中态：把系统主题的蓝色 :selected 盖掉，用设计稿的 hover + 内边框 */
.instance-list,
.instance-list row,
.instance-list row:hover,
.instance-list row:selected,
.instance-list row:selected:hover {
  background-color: transparent;
  box-shadow: none;
  outline: none;
}
.instance-item { min-height: 43px; padding: 8px 10px; }   /* 设计稿 61px(border-box) */
.instance-item:selected,
.instance-item:selected:hover,
.instance-item.active {
  background-color: $(hover);
  border-color: $(inner-border);
  box-shadow: $(card-shadow);
}
.instance-item:selected .instance-name,
.instance-item.active .instance-name { color: $(text); }
.instance-item:selected .instance-avatar,
.instance-item.active .instance-avatar {
  background-image: linear-gradient(140deg, $(accent2), $(accent));
  color: $(on-accent);
  box-shadow: 0 5px 12px alpha($(accent), .18);
}

/* 滚动条：细、无底色，悬停才明显 */
scrollbar {
  background-color: transparent;
  border: none;
  min-width: 6px;
  min-height: 6px;
}
scrollbar trough { background-color: transparent; border: none; box-shadow: none; }
scrollbar slider {
  background-color: alpha($(text), .18);
  border: none;
  border-radius: 6px;
  min-width: 4px;
  min-height: 26px;
}
scrollbar slider:hover { background-color: alpha($(text), .3); }
scrollbar.vertical { margin: 2px 0; }

/* 卡片内边距对齐设计稿（18px 20px） */
.card { padding: 18px 20px; }
/* 侧栏内边距对齐设计稿（26px 16px 18px） */
.sidebar { padding: 26px 16px 18px; }   /* 设计稿 .sidebar */
/* 主按钮：渐变之上再给一层纯色兜底（万一某些 GTK 不认角度渐变） */
.btn-primary { background-color: $(accent); }
/* 小图标/箭头 */
.glyph { color: $(muted); }
.quick-arrow { color: $(subtle); }
.log-icon { color: $(accent); }
.log-empty { color: $(muted); font-size: 9px; }
.metric-sep { min-width: 1px; background-color: $(inner-border); }

/* ==========================================================================
 * 尺寸校正（1.4.0 像素复刻）
 * GTK3 的 min-height 是内容盒：设计稿 height 含 padding/border，
 * 所以这里把每个控件的 min-height 补成 height - padding - border。
 * ========================================================================== */
.instance-item { min-height: 43px; padding: 8px 10px; }
.quick-action { min-height: 54px; padding: 13px; }
.side-link { min-height: 40px; padding: 0 11px; font-size: 11.5px; }
.new-instance {
  min-height: 34px;
  padding: 1px 6px;
  font-size: 11px;
  border: 1px dashed $(inner-border);
  border-radius: 11px;
}
.btn { min-height: 36px; padding: 0 15px; }
.btn.compact { min-height: 29px; padding: 0 10px; font-size: 9px; }
.btn.compact image { margin-right: 4px; }
.btn-icon { min-width: 36px; padding: 0; }
.icon-btn { min-width: 36px; min-height: 36px; padding: 0; }
.icon-btn.small { min-width: 25px; min-height: 25px; padding: 0; }
.large-avatar { min-width: 48px; min-height: 48px; padding: 0; }
.runtime-icon { padding: 0; }
.quick-icon { padding: 0; }
.instance-avatar { padding: 0; }
.theme-trigger {
  min-height: 32px;
  min-width: 0;
  padding: 0 10px;
  border: 1px solid $(inner-border);
  border-radius: 10px;
  background-color: $(card);
  font-size: 10.5px;
  font-weight: 550;
}
.mode-toggle {
  min-width: 55px;
  min-height: 28px;
  padding: 0;
  border: 1px solid $(inner-border);
  border-radius: 16px;
  background-color: $(card);
  font-size: 10px;
}
.side-caption { padding: 0 11px 8px; font-size: 10px; font-weight: 600; /* GTK3 不支持 letter-spacing */ }
.runtime { min-height: 54px; padding: 13px 10px; border-radius: 12px; }
.runtime-title { font-size: 10px; font-weight: 600; }
.runtime-sub { font-size: 8.5px; }
.page-footer { padding-top: 10px; font-size: 8px; }
.instance-name { font-size: 11.5px; font-weight: 600; }
.instance-sub { font-size: 10px; color: $(muted); }
.side-section-title { font-size: 11px; font-weight: 600; }

/* 日志表头 / 标题区 / 指标行：字号按设计稿收口 */
.log-header { min-height: 44px; padding: 0 18px; border-bottom: 1px solid $(inner-border); }
.log-title { font-size: 12px; font-weight: 650; }
.log-count { font-size: 8px; }
.eyebrow { font-size: 8px; font-weight: 750;  color: $(accent); }
.page-title { font-size: 25px; font-weight: 680;  }
.page-sub { font-size: 11px; }
.breadcrumb { font-size: 11px; }
.status-badge { font-size: 9px; font-weight: 600; }
.metric-label { font-size: 8.5px; }
.metric-value { font-size: 12px; font-weight: 650; }
.card-label { font-size: 11px; font-weight: 650; }
.instance-item:selected, .instance-item.active { border-radius: 13px; }
.log-line { min-height: 27px; font-size: 8.5px; }
.log-level { font-size: 7.5px; padding: 2px 4px; }

/* 卡片与分区节奏：数值取自 design/styles.css */
/* 205 是设计稿的 border-box 高度：GTK 的 min-height 只算内容盒，
   所以要减掉 padding 18*2 与 border 1*2 → 167 */
.instance-card, .control-card { min-height: 167px; }
.quick-section { margin-top: 21px; }
.section-heading { margin-bottom: 11px; }
.log-card { margin-top: 20px; }
/* 网格间距在 gui.py 里用 Gtk.Grid(column_spacing=16, row_spacing=16) 设，GTK CSS 不认这两个属性 */
.page-heading { margin-bottom: 22px; }

/* 日夜开关的滑块与图标（设计稿 .mode-thumb / .moon-icon） */
.mode-thumb { background-color: $(hover); border-radius: 11px; }
.mode-toggle button, .mode-toggle { padding: 0; }

/* 顶栏分隔线（设计稿 .top-divider：1×20 的 inner-border） */
.top-divider { background-color: $(inner-border); min-width: 1px; min-height: 20px; }
/* 内容区 padding（设计稿 .content：25px 30px 15px） */
.content { padding: 25px 30px 15px; }
/* 页脚：容器负责整行与留白，文字只负责字号/颜色（设计稿 .page-footer） */
.page-footer { padding: 12px 2px 0; }
.footer-text { color: $(subtle); font-size: 8px; }
.subtle-tag { min-height: 11px; }

/* 盒模型收口（GTK 的 min-height 只算内容盒） */
.runtime { min-height: 28px; padding: 13px 10px; }
.log-card { padding: 0; }
.side-section-title { padding: 0 8px; }

/* 设置页（设计稿 .settings-card padding 21px；两列之间留 17px） */
.settings-card { padding: 21px; }

/* 设置页信息行（设计稿 .info-list>div：min-height 40、底部 1px 内边框） */
.info-row { min-height: 38px; border-bottom: 1px solid $(inner-border); }

/* 指标行：设计稿 .metric-row 高 45（padding-top 13 + 内容 32） */
.metric-row { min-height: 44px; }

/* 日志正文区（设计稿 .log-body：padding 7px 18px 9px） */
.log-body { padding: 7px 18px 9px; }

/* ==========================================================================
 * 响应式断点（DESIGN_SPEC.md §2.5；设计稿是媒体查询，GTK 用窗口类 + 后代选择器）
 * ========================================================================== */

/* ≤1280px：侧栏 220 / 内容与顶栏 padding 22 / 快捷卡 70 高 / 卡片 padding 16 */
.narrow .content { padding: 22px; }
.narrow .topbar { padding: 0 22px; }
.narrow .quick-action { min-height: 42px; }      /* 70 - padding 26 - border 2 */
.narrow .quick-title { font-size: 10px; }
.narrow .instance-card, .narrow .control-card { padding: 16px; }
.narrow .control-sub { color: transparent; font-size: 1px; }  /* 设计稿 display:none 的等价处理 */
.narrow .log-card { margin-top: 16px; }
.narrow .brand-title { font-size: 11px; }

/* ≤850px：标题区收紧 / 卡片 190 / 区块间距收紧 / 页脚隐藏（代码里 set_visible） */
.short .content { padding-top: 18px; }
.short .page-heading { margin-bottom: 15px; }
.short .instance-card, .short .control-card { min-height: 152px; }   /* 190 - padding 36 - border 2 */
.short .quick-section { margin-top: 16px; }
.short .log-card { margin-top: 15px; }
.short .brand { margin-bottom: 18px; }
.short .runtime { margin-top: 10px; }

/* 焦点环（DESIGN_SPEC §8.3 / §10：3px 主色 25% + 2px 外偏移，不能被 outline:none 吃掉） */
button:focus, .btn:focus, .side-link:focus, .instance-item:focus,
.quick-action:focus, .icon-btn:focus {
  /* box-shadow 不参与布局；GTK3 的 outline 会计入尺寸（实测整页位移、
     宽屏 MAE 3.81→5.24），所以焦点环用阴影画。 */
  box-shadow: 0 0 0 3px alpha($(accent), .25);
}
entry:focus, spinbutton:focus {
  box-shadow: 0 0 0 3px alpha($(accent), .25);
  border-color: alpha($(accent), .5);
}

/* 禁用态（DESIGN_SPEC §7.1：透明度 45~55%，无阴影、无位移） */
button:disabled, .btn:disabled, .side-link:disabled, .quick-action:disabled {
  opacity: .48;
  box-shadow: none;
}

/* 窄屏侧栏内边距（DESIGN_SPEC §2.5：≤1280px 时左右 12px） */
.narrow .sidebar { padding-left: 12px; padding-right: 12px; }

/* 图标按钮：设计稿 .icon-btn{background:transparent;border:0}——
   GTK 默认主题会给按钮画底色/边框，必须显式清掉 */
.icon-btn, .icon-btn.small {
  background-color: transparent;
  background-image: none;
  border: 0;
  box-shadow: none;
  padding: 0;
}
.icon-btn:hover { background-color: $(hover); }

/* 运行指示：5px 成功色圆点 + 成功色文字（设计稿 .live-indicator） */
.live-indicator { color: $(success); }
.live-dot { background-color: $(success); border-radius: 3px; }
.live-text { color: $(success); font-size: 8.5px; }
.live-text.live-stopped, .live-indicator.live-stopped { color: $(muted); }
.live-dot.live-stopped { background-color: $(muted); }

/* 计数胶囊：设计稿 .count-pill{padding:1px 6px;border-radius:10px} */
.count-pill { padding: 1px 6px; border-radius: 10px; min-height: 12px; font-size: 10px; }

/* 侧栏链接：设计稿 .side-link 是无边框的透明按钮（GTK 默认按钮会画 1px 边框） */
.side-link { border: 0; border-image: none; box-shadow: none; background-image: none; }
.side-link.selected, .side-link:selected { border: 0; }

/* 状态徽标里的圆点：颜色随徽标状态（设计稿 .status-badge i{background:currentColor}） */
.badge-dot { background-color: $(muted); border-radius: 3px; }
.badge.running .badge-dot { background-color: $(success); }
.badge.needs-repair .badge-dot { background-color: $(danger); }
.badge-text { font-size: 9px; font-weight: 600; }
.badge.running .badge-text { color: $(success); }
.badge.needs-repair .badge-text { color: $(danger); }

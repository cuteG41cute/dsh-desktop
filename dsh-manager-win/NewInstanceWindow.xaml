<Window x:Class="DshManager.NewInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建实例 · DeepSeek Harness 管理器"
        Width="620" Height="560" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">

    <Border CornerRadius="{DynamicResource Radius}" Background="{DynamicResource CardSolid}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="新建实例" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="在独立目录里安装一份 DeepSeek Harness（用系统 node/npm）"
                               FontSize="10" Margin="0,6,0,0" Foreground="{DynamicResource Muted}" />
                </StackPanel>
                <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnClose" ToolTip="关闭">
                    <Path Width="14" Height="14" Data="{StaticResource Icon.x}"
                          Style="{StaticResource IconPath}" StrokeThickness="1.6" />
                </Button>
            </Grid>

            <!-- 表单 -->
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="实例名称" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,7"
                           Foreground="{DynamicResource Muted}" />
                <Border BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1" CornerRadius="10"
                        Background="{DynamicResource Card}" Height="38">
                    <TextBox x:Name="NameBox" FontSize="11" VerticalContentAlignment="Center" Margin="12,0"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Text}" Text="dsh-new" />
                </Border>

                <TextBlock Text="安装目录" FontSize="9" FontWeight="SemiBold" Margin="0,14,0,7"
                           Foreground="{DynamicResource Muted}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1" CornerRadius="10"
                            Background="{DynamicResource Card}" Height="38">
                        <TextBox x:Name="DirBox" FontSize="11" VerticalContentAlignment="Center" Margin="12,0"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Text}" />
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource BtnCompact}" Height="38" Margin="8,0,0,0"
                            Padding="12,0" Click="OnBrowse" Content="浏览…" />
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="端口" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,7"
                                   Foreground="{DynamicResource Muted}" />
                        <Border BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1" CornerRadius="10"
                                Background="{DynamicResource Card}" Height="38">
                            <TextBox x:Name="PortBox" FontSize="11" VerticalContentAlignment="Center" Margin="12,0"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text}" Text="3080" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="dsh 版本" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,7"
                                   Foreground="{DynamicResource Muted}" />
                        <Border BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1" CornerRadius="10"
                                Background="{DynamicResource Card}" Height="38">
                            <TextBox x:Name="VersionBox" FontSize="11" VerticalContentAlignment="Center" Margin="12,0"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text}" Text="latest" />
                        </Border>
                    </StackPanel>
                </Grid>
                <TextBlock Text="端口留空则由管理器自动挑一个空闲端口；版本可填 latest 或具体版本号。"
                           FontSize="8" Margin="0,8,0,0" Foreground="{DynamicResource Subtle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 日志 -->
            <Border Grid.Row="3" Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource CardSolid}"
                    BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="12,10">
                    <TextBlock x:Name="LogText" FontFamily="{StaticResource MonoFont}" FontSize="9"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- 底部 -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText" Text="" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                           MaxWidth="300" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Style="{StaticResource BtnSecondary}" Height="34" Content="取消"
                            Click="OnClose" />
                    <Button x:Name="CreateBtn" Style="{StaticResource BtnPrimary}" Height="34" Margin="8,0,0,0"
                            Content="创建实例" Click="OnCreate" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="DshManager.NewInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建实例 · DeepSeek Harness 管理器" Icon="/app.ico"
        Width="620" Height="560" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">

    <Border CornerRadius="{DynamicResource Radius}" Background="{DynamicResource CardSolid}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="新建实例" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="从官方仓库克隆一份全新实例（自带便携 Node + 独立数据目录）"
                               FontSize="10" Margin="0,6,0,0" Foreground="{DynamicResource Muted}" />
                </StackPanel>
                <Button Style="{StaticResource IconBtn}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnClose" ToolTip="关闭">
                    <Path Width="14" Height="14" Data="{StaticResource Icon.x}"
                          Style="{StaticResource IconPath}" StrokeThickness="1.6" />
                </Button>
            </Grid>

            <!-- 表单 -->
            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="实例名称" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,7"
                           Foreground="{DynamicResource Muted}" />
                <Border BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1" CornerRadius="10"
                        Background="{DynamicResource Card}" Height="38">
                    <TextBox x:Name="NameBox" FontSize="11" VerticalContentAlignment="Center" Margin="12,0" TextChanged="OnNameChanged"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Text}" Text="dsh-new" />
                </Border>

                <TextBlock Text="安装目录" FontSize="9" FontWeight="SemiBold" Margin="0,14,0,7"
                           Foreground="{DynamicResource Muted}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1" CornerRadius="10"
                            Background="{DynamicResource Card}" Height="38">
                        <TextBox x:Name="DirBox" FontSize="11" VerticalContentAlignment="Center" Margin="12,0" TextChanged="OnDirChanged"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Text}" />
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource BtnCompact}" Height="38" Margin="8,0,0,0"
                            Padding="12,0" Click="OnBrowse" Content="浏览…" />
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="端口" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,7"
                                   Foreground="{DynamicResource Muted}" />
                        <Border BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1" CornerRadius="10"
                                Background="{DynamicResource Card}" Height="38">
                            <TextBox x:Name="PortBox" FontSize="11" VerticalContentAlignment="Center" Margin="12,0"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource Text}" Text="3080" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="仓库版本" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,7"
                                   Foreground="{DynamicResource Muted}" />
                        <Border BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1" CornerRadius="10"
                                Background="{DynamicResource Card}" Height="38">
                            <ComboBox x:Name="DshVersionBox" FontSize="11" IsEditable="True" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Padding="10,0"
                                      Margin="4,0" Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource Text}" Text="latest" />
                        </Border>
                        <TextBlock Text="Node 版本" FontSize="9" FontWeight="SemiBold" Margin="0,12,0,7"
                                   Foreground="{DynamicResource Muted}" />
                        <Border BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1" CornerRadius="10"
                                Background="{DynamicResource Card}" Height="38">
                            <ComboBox x:Name="NodeVersionBox" FontSize="11" IsEditable="True" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Padding="10,0"
                                      Margin="4,0" Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource Text}" Text="latest" />
                        </Border>
                    </StackPanel>
                </Grid>
                <TextBlock Text="端口留空则由管理器自动挑一个空闲端口；版本可填 latest 或具体版本号；Node 选 system 用系统 node，选具体版本会下载便携 Node（约 30MB）。"
                           FontSize="8" Margin="0,8,0,0" Foreground="{DynamicResource Subtle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 日志 -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Border Background="{DynamicResource CardSolid}" BorderBrush="{DynamicResource InnerBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="安装方式 · 官方仓库源码" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}" />
                        <TextBlock FontSize="8.5" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Subtle}"
                                   Text="从 github.com/deepseek-ai/deepseek-harness 克隆一份全新实例：git clone → 实例内装 pnpm → pnpm install → pnpm run build。全程只用实例目录里的便携 Node，不碰全局环境；数据目录也是全新的空 dsh-home。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="LogCard" Grid.Row="3" Margin="0,16,0,0" CornerRadius="10" Background="{DynamicResource CardSolid}"
                    BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 真·进度条：安装期间一直跑；出错/完成就隐藏 -->
                    <ProgressBar x:Name="Prog" Grid.Row="0" Height="4" Margin="12,10,12,0"
                                 IsIndeterminate="True" Visibility="Collapsed"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource InnerBorder}" />
                    <ScrollViewer x:Name="LogScroll" Grid.Row="1" MinHeight="96" MaxHeight="180"
                                  VerticalScrollBarVisibility="Auto" Padding="12,10">
                        <TextBlock x:Name="LogText" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 底部 -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText" Text="" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                           MaxWidth="300" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshVersionsBtn" Style="{StaticResource BtnSecondary}" Height="34"
                            Content="更新 dsh / Node 版本" Margin="0,0,8,0" Click="OnRefreshVersions" />
                    <Button x:Name="CancelBtn" Style="{StaticResource BtnSecondary}" Height="34" Content="取消"
                            Click="OnClose" />
                    <Button x:Name="CreateBtn" Style="{StaticResource BtnPrimary}" Height="34" Margin="8,0,0,0"
                            Content="创建实例" Click="OnCreate" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

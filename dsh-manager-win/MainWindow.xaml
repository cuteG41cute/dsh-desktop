<Window x:Class="DshManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DeepSeek Harness 管理器"
        Icon="/app.ico"
        Width="1308" Height="840" MinWidth="720" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource App}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource UiFont}"
        MouseMove="OnWindowMouseMove" MouseLeftButtonUp="OnWindowMouseUp"
        LostMouseCapture="OnLostCapture">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!--
      窗口 = 「14px 透明留白（给阴影用）」+「唯一边缘：外壳那圈 1px 边框」。
      以前是 body 那层渐变页 + 里面再套一圈外壳，于是屏幕上出现两层可见边线（用户指出的双边框）。
      现在外壳铺满窗口（只留透明外沿给投影），渐变底挪到外壳内部当玻璃底，外缘只剩一条边。
    -->
    <Border MouseLeftButtonDown="OnWindowDrag" Background="{DynamicResource App}">
        <!-- 圆角应用外壳：这就是窗口唯一的边缘 -->
        <Border x:Name="Shell" Margin="0" CornerRadius="{DynamicResource AppRadius}"
                Background="{DynamicResource App}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1">
            <Grid>
                <!-- 玻璃底：设计稿 body 的渐变（在外壳内部，受同样的圆角约束） -->
                <Border CornerRadius="{DynamicResource AppRadius}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource Bg.Color}" Offset="0" />
                            <GradientStop Color="{DynamicResource Bg2.Color}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="{DynamicResource AppRadius}" Background="{DynamicResource App}" />

                <Canvas x:Name="ContentHost" ClipToBounds="True">
                <Grid x:Name="ShellContent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarCol" Width="248" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                <!-- ================= 侧栏 ================= -->
                <Border Grid.Column="0" Background="{DynamicResource Sidebar}"
                        BorderBrush="{DynamicResource InnerBorder}" BorderThickness="0,0,1,0"
                        CornerRadius="26,0,0,26">
                    <Grid x:Name="SidebarInner" Margin="16,26,16,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 品牌 -->
                        <Grid Grid.Row="0" Margin="8,0,8,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 品牌标：沿用旧启动器的黑色鲸鱼（白底圆角方，深浅主题都认得出） -->
                            <Border Width="38" Height="38" CornerRadius="12" Background="#FFFFFFFF"
                                    BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1">
                                <Image Source="Assets/whale.png" Stretch="Uniform" Margin="4,5"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel x:Name="BrandCopy" Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="BrandTitle" Text="DeepSeek Harness" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}" />
                                <TextBlock x:Name="BrandSub" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource Muted}">
                                    <Run Text="管理器 " /><Run x:Name="BrandVersion" Text="v1.0.0" Foreground="{DynamicResource Subtle}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- 我的实例 -->
                        <Grid x:Name="InstancesHeader" Grid.Row="1" Height="32" Margin="8,0,8,7">
                            <StackPanel x:Name="InstancesHeaderCopy" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="我的实例" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted}" />
                                <Border Background="{DynamicResource AccentSoft}" CornerRadius="10"
                                        Padding="6,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="InstanceCount" Text="1" FontSize="10"
                                               Foreground="{DynamicResource Accent}" />
                                </Border>
                            </StackPanel>
                            <Button x:Name="RefreshInstances" Style="{StaticResource IconBtn}" Width="25" Height="25"
                                    HorizontalAlignment="Right" ToolTip="刷新实例列表" Click="OnRefreshInstances">
                                <Path Width="16" Height="16" Data="{StaticResource Icon.restart}"
                                      Style="{StaticResource IconPath}" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="RefreshRotate" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                        </Grid>

                        <!-- 实例列表 -->
                        <StackPanel Grid.Row="2" x:Name="InstanceList" />

                        <!-- 新建实例 -->
                        <Button Grid.Row="3" Height="38" Margin="4,13,4,0" Cursor="Hand" Click="OnNewInstance"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="{DynamicResource InnerBorder}" x:Name="NewInstance">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="11" BorderThickness="1"
                                            BorderBrush="{DynamicResource InnerBorder}"
                                            Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel x:Name="NewInstanceCopy" Orientation="Horizontal">
                                <Path Width="15" Height="15" Data="{StaticResource Icon.plus}"
                                      Style="{StaticResource IconPath}" />
                                <TextBlock x:Name="NewInstanceLabel" Text="新建实例" FontSize="11" Margin="7,0,0,0"
                                           Foreground="{DynamicResource Muted}" />
                            </StackPanel>
                        </Button>

                        <!-- 底部导航 -->
                        <StackPanel Grid.Row="5">
                            <TextBlock x:Name="WorkspaceCaption" Text="工作空间" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Subtle}" Margin="11,0,0,8" />
                            <Button x:Name="OverviewNav" Style="{StaticResource SideLink}"
                                    Foreground="{DynamicResource Accent}" Background="{DynamicResource Hover}"
                                    Click="OnShowOverview">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="17" Data="{StaticResource Icon.grid}"
                                          Style="{StaticResource IconPath}"
                                          Stroke="{DynamicResource Accent}" />
                                    <TextBlock Text="实例概览" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SideLink}" x:Name="FeaturesNav" Click="OnShowTts">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="17" Data="{StaticResource Icon.puzzle}"
                                          Style="{StaticResource IconPath}" />
                                    <TextBlock Text="管理器功能" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SideLink}" x:Name="SettingsNav" Click="OnShowSettings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="17" Data="{StaticResource Icon.settings}"
                                          Style="{StaticResource IconPath}" />
                                    <TextBlock Text="管理器设置" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SideLink}" x:Name="HelpNav" Click="OnHelp">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="17" Data="{StaticResource Icon.help}"
                                          Style="{StaticResource IconPath}" />
                                    <TextBlock Text="使用帮助" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>

                            <Border Margin="4,17,4,0" Padding="10,13" CornerRadius="12"
                                    Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="8"
                                            Background="{DynamicResource AccentSoft}">
                                        <TextBlock Text=".N" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="运行环境正常" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" />
                                        <TextBlock x:Name="RuntimeLine" Text=".NET 8 · WPF"
                                                   FontSize="8.5" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Muted}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Width="5" Height="5" CornerRadius="3"
                                            Background="{DynamicResource Success}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= 主面板 ================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶栏 66 -->
                    <Border Grid.Row="0" Height="66" Background="{DynamicResource Topbar}"
                            BorderBrush="{DynamicResource InnerBorder}" BorderThickness="0,0,0,1">
                        <Grid Margin="30,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="工作空间" FontSize="11" Foreground="{DynamicResource Muted}" />
                                <TextBlock Text="/" FontSize="11" Margin="9,0"
                                           Foreground="{DynamicResource Subtle}" />
                                <TextBlock x:Name="Breadcrumb" Text="实例概览" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- 主题选择 -->
                                <Button x:Name="ThemeTrigger" Height="34" Padding="10,0" Cursor="Hand"
                                        Click="OnThemeTrigger"
                                        Background="{DynamicResource Card}"
                                        BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="14" Height="14" CornerRadius="5">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{DynamicResource Accent2.Color}" Offset="0" />
                                                    <GradientStop Color="{DynamicResource Accent.Color}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock x:Name="ThemeName" Text="毛玻璃" FontSize="10.5" FontWeight="SemiBold"
                                                   Margin="8,0,0,0" Foreground="{DynamicResource Text}" />
                                        <Path Width="14" Height="14" Data="{StaticResource Icon.chevron}"
                                              Style="{StaticResource IconPath}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>

                                <!-- 昼夜切换 57×30 -->
                                <Border x:Name="ModeToggle" Width="57" Height="30" CornerRadius="16" Margin="10,0,0,0"
                                        Background="{DynamicResource Card}" BorderBrush="{DynamicResource InnerBorder}"
                                        BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="OnToggleMode">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Path x:Name="SunIcon" Width="14" Height="14"
                                                  Data="{StaticResource Icon.sun}" Style="{StaticResource IconPath}"
                                                  Stroke="{DynamicResource Accent}" />
                                            <Path x:Name="MoonIcon" Width="14" Height="14" Margin="15,0,0,0"
                                                  Data="{StaticResource Icon.moon}" Style="{StaticResource IconPath}"
                                                  Opacity="0.55" />
                                        </StackPanel>
                                        <Border x:Name="ModeThumb" Width="22" Height="22" CornerRadius="11"
                                                HorizontalAlignment="Left" Margin="3,0,0,0"
                                                Background="{DynamicResource Hover}" />
                                    </Grid>
                                </Border>

                                <Border Width="1" Height="20" Margin="12,0"
                                        Background="{DynamicResource InnerBorder}" />
                                <Button Style="{StaticResource IconBtn}" ToolTip="关于" Click="OnAbout">
                                    <Path Width="20" Height="20" Data="{StaticResource Icon.info}"
                                          Style="{StaticResource IconPath}" />
                                </Button>

                                <!-- 窗口按钮（Windows 版专属：无边框窗口） -->
                                <Button Style="{StaticResource IconBtn}" x:Name="MinBtn" Click="OnMinimize" ToolTip="最小化">
                                    <Path Width="14" Height="14" Data="M4 12 H20" Style="{StaticResource IconPath}"
                                          StrokeThickness="1.6" />
                                </Button>
                                <Button Style="{StaticResource IconBtn}" x:Name="MaxBtn" Click="OnMaximize" ToolTip="最大化">
                                    <Path Width="13" Height="13" Data="M4 4 H20 V20 H4 Z" Style="{StaticResource IconPath}"
                                          StrokeThickness="1.6" />
                                </Button>
                                <Button Style="{StaticResource IconBtn}" x:Name="CloseBtn" Click="OnClose" ToolTip="关闭">
                                    <Path Width="14" Height="14" Data="{StaticResource Icon.x}"
                                          Style="{StaticResource IconPath}" StrokeThickness="1.6" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 内容区 -->
                    <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,25,30,15">
                        <StackPanel>
                            <!-- 页头 -->
                            <Grid Margin="0,0,0,22">
                                <StackPanel>
                                    <TextBlock Text="INSTANCE OVERVIEW" FontSize="8" FontWeight="Bold"
                                               Foreground="{DynamicResource Accent}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock x:Name="InstanceTitle" Text="实例概览" FontSize="25"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                                        <Border x:Name="StatusBadge" Background="{DynamicResource SuccessSoft}"
                                                CornerRadius="12" Padding="9,4" Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="StatusBadgeDot" Width="5" Height="5" CornerRadius="3"
                                                        Background="{DynamicResource Success}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="StatusBadgeText" Text="运行中" FontSize="9"
                                                           FontWeight="SemiBold" Margin="5,0,0,0"
                                                           Foreground="{DynamicResource Success}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="PageDesc" Text="管理服务、窗口与扩展，让实例始终保持最佳状态。" FontSize="11"
                                               Margin="0,7,0,0" Foreground="{DynamicResource Muted}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button Style="{StaticResource BtnSecondary}" x:Name="WindowFeaturesBtn"
                                            Height="34" Padding="15,0" Margin="0,0,8,0" Cursor="Hand"
                                            Click="OnWindowFeatures">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Data="{StaticResource Icon.info}"
                                                  Style="{StaticResource IconPath}" Stroke="{DynamicResource Muted}" />
                                            <TextBlock Text="窗口功能" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnPrimary}" x:Name="OpenWindowBtn" Click="OnOpenWindow">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16" Data="{StaticResource Icon.external}"
                                                  Style="{StaticResource IconPath}" Stroke="{DynamicResource OnAccent}" />
                                            <TextBlock Text="打开窗口" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnIcon}" Margin="8,0,0,0" x:Name="MoreBtn" Click="OnMore">
                                        <Path Width="16" Height="16" Data="{StaticResource Icon.more}"
                                              Style="{StaticResource IconPath}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 概览两卡 -->
                            <Grid x:Name="OverviewGrid" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.65*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1*" MinWidth="330" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="InstanceCard" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20,18">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="实例信息" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text}" />
                                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="6"
                                                    Padding="7,3" HorizontalAlignment="Right">
                                                <TextBlock Text="本地实例" FontSize="8"
                                                           Foreground="{DynamicResource Muted}" />
                                            </Border>
                                        </DockPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                                            <Border Width="48" Height="48" CornerRadius="14">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
                                                        <GradientStop Color="{DynamicResource Accent2.Color}" Offset="0" />
                                                        <GradientStop Color="{DynamicResource Accent.Color}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock x:Name="AvatarText" Text="D1" Foreground="{DynamicResource OnAccent}"
                                                           FontSize="14" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="DeepSeek Harness" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text}" />
                                                <TextBlock x:Name="InstallPath" Text="—" FontSize="9" Margin="0,4,0,0"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource Muted}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="430" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Border BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1"
                                                            CornerRadius="6" Padding="7,3">
                                                        <TextBlock FontSize="8" Foreground="{DynamicResource Muted}">
                                                            <Run Text="dsh " /><Run x:Name="DshVersion" Text="—"
                                                                Foreground="{DynamicResource Text}" FontWeight="SemiBold" />
                                                        </TextBlock>
                                                    </Border>
                                                    <Border BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1"
                                                            CornerRadius="6" Padding="7,3" Margin="6,0,0,0">
                                                        <TextBlock FontSize="8" Foreground="{DynamicResource Muted}">
                                                            <Run Text="Node " /><Run x:Name="NodeVersion" Text="—"
                                                                Foreground="{DynamicResource Text}" FontWeight="SemiBold" />
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Margin="0,18,0,0" Height="46">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="进程 PID" FontSize="8.5"
                                                           Foreground="{DynamicResource Muted}" />
                                                <TextBlock x:Name="PidValue" Text="—" FontSize="12" FontWeight="SemiBold"
                                                           Margin="0,4,0,0" Foreground="{DynamicResource Text}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" BorderBrush="{DynamicResource InnerBorder}"
                                                    BorderThickness="1,0,0,0" Padding="15,0">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="服务端口" FontSize="8.5"
                                                               Foreground="{DynamicResource Muted}" />
                                                    <TextBlock x:Name="PortValue" Text="—" FontSize="12"
                                                               FontWeight="SemiBold" Margin="0,4,0,0"
                                                               Foreground="{DynamicResource Text}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" BorderBrush="{DynamicResource InnerBorder}"
                                                    BorderThickness="1,0,0,0" Padding="15,0">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="运行状态" FontSize="8.5"
                                                               Foreground="{DynamicResource Muted}" />
                                                    <TextBlock x:Name="RunState" Text="—" FontSize="12"
                                                               FontWeight="SemiBold" Margin="0,4,0,0"
                                                               Foreground="{DynamicResource Success}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ControlCard" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20,18">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="快捷控制" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Border x:Name="SvcDot" Width="5" Height="5" CornerRadius="3"
                                                        Background="{DynamicResource Success}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="SvcState" Text="服务正常" FontSize="8.5" Margin="5,0,0,0"
                                                           Foreground="{DynamicResource Success}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <Grid Margin="0,21,0,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="服务" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text}" />
                                                <TextBlock Text="后台进程与连接" FontSize="8.5" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource Muted}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource BtnCompact}" Click="OnRestartService">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="13" Height="13" Data="{StaticResource Icon.restart}"
                                                              Style="{StaticResource IconPath}" />
                                                        <TextBlock Text="重启" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="StopBtn" Style="{StaticResource BtnCompact}" Margin="6,0,0,0"
                                                        Background="{DynamicResource DangerSoft}"
                                                        BorderThickness="0" Foreground="{DynamicResource Danger}"
                                                        Click="OnStopService">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path x:Name="StopIcon" Width="13" Height="13" Data="{StaticResource Icon.stop}"
                                                              Style="{StaticResource IconPath}"
                                                              Stroke="{DynamicResource Danger}" />
                                                        <TextBlock x:Name="StopLabel" Text="停止" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Margin="0,17,0,0" Background="{DynamicResource InnerBorder}" />

                                        <Grid Margin="0,17,0,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="窗口" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text}" />
                                                <TextBlock Text="界面与页面状态" FontSize="8.5" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource Muted}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource BtnCompact}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="13" Height="13" Data="{StaticResource Icon.refresh}"
                                                              Style="{StaticResource IconPath}" />
                                                        <TextBlock Text="重载" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource BtnCompact}" Margin="6,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="13" Height="13" Data="{StaticResource Icon.restart}"
                                                              Style="{StaticResource IconPath}" />
                                                        <TextBlock Text="重建" Margin="5,0,0,0" />

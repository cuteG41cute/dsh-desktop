                <StackPanel>
                    <TextBlock Text="管理器功能" FontSize="25" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="不依赖任何实例、由管理器自己提供的能力"
                               FontSize="9.5" Margin="0,7,0,0" Foreground="{DynamicResource Muted}" />

                    <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Data="{StaticResource Icon.wrench}"
                              Style="{StaticResource IconPath}" Stroke="{DynamicResource Accent}" />
                        <TextBlock Text="本地服务" FontSize="8.5" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 项目备份 / 恢复 卡 -->

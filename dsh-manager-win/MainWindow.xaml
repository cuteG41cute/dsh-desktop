                                            <Button Grid.Column="1" Content="浏览" Style="{StaticResource BtnSecondary}"
                                                    Height="32" Padding="14,0" FontSize="9" Margin="0,18,14,0"
                                                    Click="OnPbPlanBrowse" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="每个项目保留份数" FontSize="8" Foreground="{DynamicResource Subtle}" />
                                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource InnerBorder}"
                                                        Background="{DynamicResource Card}" Padding="10,7" Margin="0,4,0,0">
                                                    <TextBox x:Name="PbPlanKeep" FontSize="9" BorderThickness="0"
                                                             Background="Transparent" Text="1" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox x:Name="PbPlanDays" Content="同时最多保留" FontSize="9" />
                                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource InnerBorder}"
                                                        Background="{DynamicResource Card}" Padding="8,5" Margin="6,0,4,0" Width="52">
                                                    <TextBox x:Name="PbPlanDaysValue" FontSize="9" BorderThickness="0"
                                                             Background="Transparent" Text="30" />
                                                </Border>
                                                <TextBlock Text="天" FontSize="9" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Muted}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <CheckBox x:Name="PbPlanSessions" Content="会话历史" FontSize="9" IsChecked="True" />
                                                <CheckBox x:Name="PbPlanFiles" Content="项目文件" FontSize="9" IsChecked="True" Margin="10,0,0,0" />
                                                <CheckBox x:Name="PbPlanAttach" Content="引用附件" FontSize="9" IsChecked="True" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <TextBlock x:Name="PbPlanNext" Text="" FontSize="8.5" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Subtle}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="PbPlanSaved" Text="" FontSize="8.5" Margin="0,0,10,0"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource Success}" />
                                                <Button Content="保存计划" Style="{StaticResource BtnPrimary}" Height="30"
                                                        Padding="16,0" FontSize="9" Click="OnPbPlanSave" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,14,0,6">
                                    <TextBlock Text="备份历史" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text}" />
                                    <Button Content="立即备份" Style="{StaticResource BtnCompact}" Height="26" Padding="10,0"
                                            FontSize="8.5" HorizontalAlignment="Right" Click="OnPbBackupNow" />
                                </Grid>
                                <TextBlock x:Name="PbHistoryEmpty" Text="还没有备份" FontSize="9" Margin="2,8,0,8"
                                           Foreground="{DynamicResource Subtle}" Visibility="Collapsed" />
                                <ItemsControl x:Name="PbHistoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" CornerRadius="9" BorderThickness="1"
                                                    BorderBrush="{DynamicResource InnerBorder}"
                                                    Background="{DynamicResource CardSolid}" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Text}" />
                                                        <TextBlock Text="{Binding Meta}" FontSize="8" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource Muted}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="8.5"
                                                                   Foreground="{DynamicResource Success}" VerticalAlignment="Center"
                                                                   Margin="0,0,10,0" />
                                                        <Button Content="恢复" Style="{StaticResource BtnCompact}" Height="26"
                                                                Padding="10,0" FontSize="8.5" Tag="{Binding File}"
                                                                Click="OnPbHistoryRestore" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel x:Name="PbBakDav" Visibility="Collapsed">
                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource InnerBorder}"
                                        Background="{DynamicResource CardSolid}" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="WebDAV 连接" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource InnerBorder}"
                                                    Background="{DynamicResource Card}" Padding="10,7">
                                                <TextBox x:Name="PbDavUrl" FontSize="9" BorderThickness="0"
                                                         Background="Transparent" />
                                            </Border>
                                            <Button Grid.Column="1" Content="测试连接" Style="{StaticResource BtnSecondary}"
                                                    Height="32" Padding="14,0" FontSize="9" Margin="8,0,0,0"
                                                    Click="OnPbDavTest" />
                                        </Grid>
                                        <TextBlock x:Name="PbDavStatus" Text="" FontSize="8.5" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource Muted}" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource InnerBorder}"
                                                    Background="{DynamicResource Card}" Padding="10,7" Margin="0,0,8,0">
                                                <TextBox x:Name="PbDavUser" FontSize="9" BorderThickness="0"
                                                         Background="Transparent" Text="用户名" Foreground="{DynamicResource Subtle}" />
                                            </Border>
                                            <Border Grid.Column="1" CornerRadius="8" BorderThickness="1"
                                                    BorderBrush="{DynamicResource InnerBorder}"
                                                    Background="{DynamicResource Card}" Padding="10,7">
                                                <TextBox x:Name="PbDavPass" FontSize="9" BorderThickness="0"
                                                         Background="Transparent" Text="密码" Foreground="{DynamicResource Subtle}" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="WebDAV 上传将在下一轮接入（先把连接测试跑通）。" FontSize="8.5"
                                           Margin="2,10,0,0" Foreground="{DynamicResource Subtle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 任务日志 -->
                        <StackPanel x:Name="PbPanelLogs" Visibility="Collapsed" Margin="16,12,16,16">
                            <TextBlock Text="任务日志" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                            <TextBlock Text="执行导出 / 恢复 / 备份后，这里会显示时间、结果与详情。" FontSize="8.5" Margin="0,6,0,0"
                                       Foreground="{DynamicResource Subtle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="0">
                <StackPanel>
            <Button x:Name="VoiceCardTrigger" Style="{StaticResource CardSummaryBtn}" Click="OnToggleVoiceCard">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="13">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C6CF0" Offset="0" />
                                <GradientStop Color="#B08CF5" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Width="20" Height="20" Data="{StaticResource Icon.mic}"
                              Style="{StaticResource IconPath}" Stroke="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="本地语音模型" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock x:Name="VoiceCardStatus" Text="已停止" FontSize="8" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Subtle}" />
                        </StackPanel>
                        <TextBlock Text="Qwen3-TTS · OpenAI 兼容 /v1/audio/speech" FontSize="8.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="VoiceCardSummary" Text="2 个参考音色" FontSize="9.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource Text}" />
                        <TextBlock Text="127.0.0.1:8092" FontSize="8" Margin="0,3,0,0"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource Subtle}" />
                    </StackPanel>
                    <Path x:Name="VoiceCardChevron" Grid.Column="3" Width="12" Height="12"
                          Data="{StaticResource Icon.chevron}" Style="{StaticResource IconPath}"
                          Stroke="{DynamicResource Muted}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="VoiceCardChevronRotate" Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Button>
            <StackPanel x:Name="VoiceCardBody" Visibility="Collapsed">
                    <!-- Hero -->
                    <Grid Margin="20,16,20,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="46" Height="46" CornerRadius="14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#7C6CF0" Offset="0" />
                                        <GradientStop Color="#B08CF5" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Width="22" Height="22" Data="{StaticResource Icon.mic}"
                                      Style="{StaticResource IconPath}" Stroke="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="本地语音模型" FontSize="15.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                                    <Border x:Name="TtsStatusBadge" Background="{DynamicResource InnerBorder}"
                                            CornerRadius="7" Padding="7,1" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TtsStatusText" Text="检查中" FontSize="8"
                                                   Foreground="{DynamicResource Muted}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Qwen3-TTS · OpenAI 兼容 /v1/audio/speech"
                                           FontSize="8.5" Margin="0,3,0,0" Foreground="{DynamicResource Muted}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse x:Name="TtsReadyDot" Width="6" Height="6" Fill="{DynamicResource Subtle}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="TtsReadyText" Text="服务未运行" FontSize="8.5" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Muted}" />
                            </StackPanel>
                            <Button x:Name="TtsToggleBtn" Content="启动服务" Style="{StaticResource BtnSecondary}"
                                    Height="32" Padding="16,0" Click="OnTtsToggle" />
                        </StackPanel>
                    </Grid>

                    <!-- 部署摘要 -->
                    <Border BorderThickness="0,1,0,1" BorderBrush="{DynamicResource InnerBorder}" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" MinWidth="120">
                                <TextBlock Text="服务端口" FontSize="8" Foreground="{DynamicResource Subtle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock x:Name="TtsPortText" Text="8098" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" />
                                    <TextBlock Text=" · 仅本机访问" FontSize="8" Margin="4,0,0,0"
                                               VerticalAlignment="Bottom" Foreground="{DynamicResource Subtle}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="20,0,20,0">
                                <TextBlock Text="模型文件" FontSize="8" Foreground="{DynamicResource Subtle}" />
                                <TextBlock x:Name="TtsModelText" Text="—" FontSize="9.5" Margin="0,4,0,0"
                                           FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Text}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" MinWidth="90" Margin="0,0,20,0">
                                <TextBlock Text="占用空间" FontSize="8" Foreground="{DynamicResource Subtle}" />
                                <TextBlock x:Name="TtsSizeText" Text="—" FontSize="12" FontWeight="SemiBold"
                                           Margin="0,3,0,0" Foreground="{DynamicResource Text}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="程序目录" Style="{StaticResource BtnCompact}" Height="26"
                                        Padding="10,0" FontSize="8.5" Click="OnTtsFolder" />
                                <Button Content="查看日志" Style="{StaticResource BtnCompact}" Height="26"
                                        Padding="10,0" FontSize="8.5" Margin="8,0,0,0" Click="OnTtsLog" />
                                <Button x:Name="TtsWebUiBtn" Content="打开管理页" Style="{StaticResource BtnCompact}" Height="26"
                                        Padding="10,0" FontSize="8.5" Margin="8,0,0,0" Click="OnTtsOpenWebUi"
                                        Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="20,12,20,0" CornerRadius="9" BorderThickness="1"
                            BorderBrush="{DynamicResource InnerBorder}" Background="{DynamicResource Card}"
                            Padding="12,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="推理后端" FontSize="8" Foreground="{DynamicResource Subtle}" />
                                    <ComboBox x:Name="TtsBackendCombo" Width="220" Height="28" FontSize="9"
                                              Margin="0,4,0,0" SelectionChanged="OnTtsBackendChanged" Style="{StaticResource TtsCombo}" ItemContainerStyle="{StaticResource TtsComboItem}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="TtsRuntimeText" Text="" FontSize="8.5"
                                           Margin="14,0,0,0" VerticalAlignment="Bottom" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Muted}" />
                                <Button Grid.Column="2" x:Name="TtsRuntimeBtn" Content="安装运行时"
                                        Style="{StaticResource BtnSecondary}" Height="28" Padding="12,0"
                                        FontSize="9" VerticalAlignment="Bottom"
                                        Click="OnTtsDownloadRuntime" Visibility="Collapsed" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource InnerBorder}" Margin="0,10,0,0" />
                            <TextBlock Text="模型库" FontSize="8" Margin="0,8,0,4"
                                       Foreground="{DynamicResource Subtle}" />
                            <StackPanel x:Name="TtsModelList" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="TtsDownloadBox" Orientation="Horizontal" Margin="20,12,20,0"
                                Visibility="Collapsed">
                        <Button x:Name="TtsDownloadBtn" Content="下载模型" Style="{StaticResource BtnPrimary}"
                                Height="30" Padding="14,0" FontSize="9.5" Click="OnTtsDownload" />
                        <ProgressBar x:Name="TtsDownloadBar" Width="220" Height="6" Margin="12,0,0,0"
                                     VerticalAlignment="Center" Minimum="0" Maximum="1" />
                        <TextBlock x:Name="TtsDownloadText" Text="" FontSize="8.5" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                    </StackPanel>

                    <!-- 两栏工作区 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="1.08*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：参考音色 -->
                        <StackPanel Grid.Column="0" Margin="20,14,18,16">
                            <Grid Margin="0,0,0,4">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="参考音色" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" />
                                        <Border Background="{DynamicResource InnerBorder}" CornerRadius="7"
                                                Padding="6,0" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TtsVoiceCount" Text="0" FontSize="8"
                                                       Foreground="{DynamicResource Muted}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="上传干净人声，创建可用于合成的音色" FontSize="8" Margin="0,4,0,0"
                                               Foreground="{DynamicResource Subtle}" />
                                </StackPanel>
                                <Button x:Name="NewVoiceBtn" Content="新建音色" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Style="{StaticResource BtnSecondary}" Height="28" Padding="12,0" FontSize="9"
                                        Click="OnTtsNewVoice" />
                            </Grid>

                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="10,7" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="没有内置音色时，请上传一段 5–20 秒的干净人声作为参考；Kokoro 等模型可直接选下面的预设音色。"
                                               FontSize="8.2" Margin="7,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                                <StackPanel x:Name="TtsVoiceList" />
                            </ScrollViewer>

                            <Button x:Name="TtsUploadZone" Margin="0,8,0,0" Height="46" Click="OnTtsNewVoice"
                                    Background="Transparent" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Rectangle RadiusX="9" RadiusY="9" StrokeThickness="1"
                                                       Stroke="{DynamicResource InnerBorder}"
                                                       StrokeDashArray="3 3" Fill="Transparent" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Path Width="13" Height="13" Data="{StaticResource Icon.plus}"
                                                      Style="{StaticResource IconPath}" Stroke="{DynamicResource Muted}" />
                                                <TextBlock Text="上传参考音频" FontSize="9.5" Margin="7,0,0,0"
                                                           Foreground="{DynamicResource Muted}" />
                                                <TextBlock Text="WAV / MP3 · 建议 16kHz 单声道" FontSize="8" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource Subtle}" />
                                            </StackPanel>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 试听/合成状态：生成中显示耗时与不确定进度条 -->
                            <Border x:Name="TtsVoiceStatusBox" Margin="0,8,0,0" CornerRadius="8"
                                    Padding="9,6" Background="{DynamicResource AccentSoft}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar x:Name="TtsVoiceStatusBar" Width="70" Height="4"
                                                 IsIndeterminate="True" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Accent}" />
                                    <TextBlock x:Name="TtsVoiceStatusText" Text="0.0 秒 · 生成中…"
                                               FontSize="8.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Muted}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{DynamicResource InnerBorder}" />

                        <!-- 右：朗读接入 -->
                        <StackPanel Grid.Column="2" Margin="18,14,20,16">
                            <TextBlock Text="朗读接入" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock Text="用于会话朗读的 OpenAI 兼容配置" FontSize="8" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Subtle}" />

                            <TextBlock Text="接口地址" FontSize="8" Margin="0,12,0,4" Foreground="{DynamicResource Subtle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Height="32" CornerRadius="8" BorderThickness="1" Background="{DynamicResource Card}"
                                        BorderBrush="{DynamicResource InnerBorder}">
                                    <TextBox x:Name="TtsEndpointBox" FontSize="9.5" BorderThickness="0" Background="Transparent"
                                             IsReadOnly="True" Margin="9,0" VerticalContentAlignment="Center"
                                             FontFamily="Consolas" />
                                </Border>
                                <Button Grid.Column="1" Width="32" Height="32" Margin="8,0,0,0" Cursor="Hand"
                                        Style="{StaticResource BtnCompact}" Click="OnTtsCopyEndpoint" ToolTip="复制">
                                    <Path Width="13" Height="13" Data="{StaticResource Icon.copy}"
                                          Style="{StaticResource IconPath}" />
                                </Button>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="模型" FontSize="8" Margin="0,0,0,4" Foreground="{DynamicResource Subtle}" />
                                    <Border Height="32" CornerRadius="8" BorderThickness="1" Background="{DynamicResource Card}"
                                            BorderBrush="{DynamicResource InnerBorder}">
                                        <TextBox x:Name="TtsModelBox" FontSize="9.5" BorderThickness="0" Background="Transparent"
                                                 IsReadOnly="True" Margin="9,0" VerticalContentAlignment="Center"
                                                 FontFamily="Consolas" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="音色" FontSize="8" Margin="0,0,0,4" Foreground="{DynamicResource Subtle}" />
                                    <ComboBox x:Name="TtsVoiceCombo" Height="32" FontSize="9.5" SelectionChanged="OnTtsVoiceChanged" Style="{StaticResource TtsCombo}" ItemContainerStyle="{StaticResource TtsComboItem}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="语速" FontSize="8" Margin="0,0,0,4" Foreground="{DynamicResource Subtle}" />
                                    <ComboBox x:Name="TtsSpeedCombo" Height="32" FontSize="9.5" Style="{StaticResource TtsCombo}" ItemContainerStyle="{StaticResource TtsComboItem}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="格式" FontSize="8" Margin="0,0,0,4" Foreground="{DynamicResource Subtle}" />
                                    <Border Height="32" CornerRadius="8" BorderThickness="1" Background="{DynamicResource Card}"
                                            BorderBrush="{DynamicResource InnerBorder}">
                                        <TextBox Text="WAV" FontSize="9.5" BorderThickness="0" Background="Transparent"
                                                 IsReadOnly="True" Margin="9,0" VerticalContentAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="API Key　本地服务可留空" FontSize="8" Margin="0,10,0,4"
                                       Foreground="{DynamicResource Subtle}" />
                            <Border Height="32" CornerRadius="8" BorderThickness="1" Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource InnerBorder}">
                                <TextBox x:Name="TtsApiKeyBox" FontSize="9.5" BorderThickness="0" Background="Transparent"
                                         Margin="9,0" VerticalContentAlignment="Center" />
                            </Border>

                            <TextBlock Text="试听文本" FontSize="8" Margin="0,10,0,4" Foreground="{DynamicResource Subtle}" />
                            <Border CornerRadius="8" BorderThickness="1" Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource InnerBorder}" Padding="9,8">
                                <TextBox x:Name="TtsSynthText" FontSize="9.5" BorderThickness="0" Background="Transparent"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="100"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="你好，这是由本地模型合成的语音。" />
                            </Border>

                            <Grid Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="11" Height="11" Data="{StaticResource Icon.info}"
                                          Style="{StaticResource IconPath}" Stroke="{DynamicResource Subtle}" />
                                    <TextBlock Text="合成将在本机完成，不会上传文本" FontSize="8" Margin="5,0,0,0"
                                               Foreground="{DynamicResource Subtle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TtsSynthStatus" Text="" FontSize="8" Margin="0,0,10,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                    <Button x:Name="TtsSynthBtn" Content="合成并播放" Style="{StaticResource BtnPrimary}"
                                            Height="30" Padding="14,0" FontSize="9.5" Click="OnTtsSynth" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- 运行说明 -->
                    <Border Background="{DynamicResource AccentSoft}" Padding="20,11">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Data="{StaticResource Icon.info}"
                                  Style="{StaticResource IconPath}" Stroke="{DynamicResource Accent}"
                                  VerticalAlignment="Center" />
                            <TextBlock Margin="7,0,0,0" FontSize="8.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Muted}">
                                <Run Text="运行说明" FontWeight="SemiBold" />
                                <Run Text="　服务由管理器启动 / 停止，日志位于 services\tts\logs\server.log；CPU 推理速度约为实时的 0.3 倍，长文本请先在管理页合成再播放。" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
            </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Padding="30,25,30,15">
                        <StackPanel>
                            <Grid Margin="0,0,0,22">
                                <StackPanel>
                                    <TextBlock Text="MANAGER PREFERENCES" FontSize="8" FontWeight="Bold"
                                               Foreground="{DynamicResource Accent}" />
                                    <TextBlock Text="管理器设置" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,0"
                                               Foreground="{DynamicResource Text}" />
                                    <TextBlock Text="查看运行环境，管理外观与维护选项。" FontSize="11" Margin="0,7,0,0"
                                               Foreground="{DynamicResource Muted}" />
                                </StackPanel>
                                <Button x:Name="SaveSettingsBtn" Style="{StaticResource BtnPrimary}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="OnSaveSettings">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="16" Height="16" Data="{StaticResource Icon.check}"
                                              Style="{StaticResource IconPath}" Stroke="{DynamicResource OnAccent}" />
                                        <TextBlock Text="保存设置" Margin="7,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="17" />
                                    <ColumnDefinition Width="1*" MinWidth="320" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <!-- 管理器信息 -->
                                    <Border Style="{StaticResource CardStyle}" Padding="21">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="34" Height="34" CornerRadius="10"
                                                        Background="{DynamicResource AccentSoft}">
                                                    <Path Width="17" Height="17" Data="{StaticResource Icon.info}"
                                                          Style="{StaticResource IconPath}" Stroke="{DynamicResource Accent}" />
                                                </Border>
                                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="管理器信息" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Text}" />
                                                    <TextBlock Text="当前安装与运行环境" FontSize="9" Margin="0,4,0,0"
                                                               Foreground="{DynamicResource Muted}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Height="1" Margin="0,17,0,0" Background="{DynamicResource InnerBorder}" />
                                            <StackPanel x:Name="InfoList" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 维护与诊断 -->
                                    <Border Style="{StaticResource CardStyle}" Padding="21" Margin="0,17,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="34" Height="34" CornerRadius="10"
                                                        Background="{DynamicResource AccentSoft}">
                                                    <Path Width="17" Height="17" Data="{StaticResource Icon.wrench}"
                                                          Style="{StaticResource IconPath}" Stroke="{DynamicResource Accent}" />
                                                </Border>
                                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="维护与诊断" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Text}" />
                                                    <TextBlock Text="排查问题或检查更新" FontSize="9" Margin="0,4,0,0"
                                                               Foreground="{DynamicResource Muted}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <WrapPanel Margin="0,17,0,0">
                                                <Button Style="{StaticResource BtnSecondary}" Height="34" FontSize="9"
                                                        Margin="0,0,8,8" Click="OnOpenManagerLog">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="14" Height="14" Data="{StaticResource Icon.terminal}"
                                                              Style="{StaticResource IconPath}" />
                                                        <TextBlock Text="查看管理器日志" Margin="7,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource BtnSecondary}" Height="34" FontSize="9"
                                                        Margin="0,0,8,8" Click="OnCopyDiagnostics">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="14" Height="14" Data="{StaticResource Icon.copy}"
                                                              Style="{StaticResource IconPath}" />
                                                        <TextBlock Text="复制诊断信息" Margin="7,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource BtnSecondary}" Height="34" FontSize="9"
                                                        Margin="0,0,8,8" Click="OnCheckUpdate">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Width="14" Height="14" Data="{StaticResource Icon.update}"
                                                              Style="{StaticResource IconPath}" />
                                                        <TextBlock Text="检查更新" Margin="7,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 外观与日志 -->
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="21"
                                        VerticalAlignment="Top">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="10"
                                                    Background="{DynamicResource AccentSoft}">
                                                <Path Width="17" Height="17" Data="{StaticResource Icon.palette}"
                                                      Style="{StaticResource IconPath}" Stroke="{DynamicResource Accent}" />
                                            </Border>
                                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="外观与日志" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text}" />
                                                <TextBlock Text="个性化你的工作空间" FontSize="9" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource Muted}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Text="界面主题" FontSize="9" FontWeight="SemiBold" Margin="0,18,0,8"
                                                   Foreground="{DynamicResource Muted}" />
                                        <Border Padding="12" CornerRadius="11" Background="{DynamicResource AccentSoft}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="9">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="{DynamicResource Accent2.Color}" Offset="0" />
                                                            <GradientStop Color="{DynamicResource Accent.Color}" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="SettingsThemeName" Text="毛玻璃" FontSize="10"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                                                    <TextBlock x:Name="SettingsModeName" Text="日间模式" FontSize="8"
                                                               Margin="0,3,0,0" Foreground="{DynamicResource Muted}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Cursor="Hand" Background="Transparent"
                                                        BorderThickness="0" VerticalAlignment="Center"
                                                        Click="OnSettingsChangeTheme">
                                                    <TextBlock Text="更换主题" FontSize="9"
                                                               Foreground="{DynamicResource Accent}" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="日志面板保留行数" FontSize="9" FontWeight="SemiBold"
                                                   Margin="0,18,0,8" Foreground="{DynamicResource Muted}" />
                                        <Border BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1"
                                                CornerRadius="10" Background="{DynamicResource Card}" Height="38">
                                            <Grid>
                                                <TextBox x:Name="LogLinesBox" Text="800" FontSize="11"
                                                         VerticalContentAlignment="Center" Margin="12,0,40,0"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource Text}" />
                                                <TextBlock Text="行" FontSize="9" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                                           Foreground="{DynamicResource Muted}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="建议保留 500–1500 行，过多可能影响性能。" FontSize="8"
                                                   Margin="0,7,0,0" Foreground="{DynamicResource Subtle}" />

                                        <Border Margin="0,19,0,0" Padding="11" CornerRadius="10"
                                                Background="{DynamicResource AccentSoft}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14" Height="14" Data="{StaticResource Icon.info}"
                                                      Style="{StaticResource IconPath}" Stroke="{DynamicResource Accent}"
                                                      VerticalAlignment="Top" />
                                                <TextBlock Text="主题切换会立即预览，无需重启管理器。" FontSize="8.5"
                                                           Margin="8,0,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Muted}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                </Grid>
                </Canvas>
                <!-- 迁移弹窗层 -->
    <Grid x:Name="PbModalLayer" Visibility="Collapsed" Background="#66000000">
        <Border Width="560" MaxHeight="640" CornerRadius="18" Background="{DynamicResource CardSolid}"
                BorderThickness="1" BorderBrush="{DynamicResource InnerBorder}" HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <!-- 导出 -->
                <StackPanel x:Name="PbExportPanel" Visibility="Collapsed" Margin="26,22,26,22">
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="导出项目" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                            <TextBlock Text="生成包含项目文件、会话和附件的迁移包。" FontSize="9" Margin="0,5,0,0"
                                       Foreground="{DynamicResource Muted}" />
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource BtnCompact}" Width="30" Height="30"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnPbExportClose" />
                    </Grid>
                    <Border CornerRadius="9" Background="{DynamicResource AccentSoft}" Padding="12,9" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="PbExportProject" Text="" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock x:Name="PbExportSource" Text="" FontSize="8" Margin="0,3,0,0"
                                       Foreground="{DynamicResource Muted}" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="PbExportOptions">
                        <CheckBox x:Name="PbExpSessions" Content="会话历史" IsChecked="True" FontSize="9.5" Margin="0,0,0,8" />
                        <CheckBox x:Name="PbExpFiles" Content="项目文件（含 .dsh 隐藏配置、记忆库和文件历史）" IsChecked="True"
                                  FontSize="9.5" Margin="0,0,0,8" />
                        <CheckBox x:Name="PbExpAttachments" Content="引用附件" IsChecked="True" FontSize="9.5" Margin="0,0,0,8" />
                        <CheckBox x:Name="PbExpConfig" Content="机器配置（端口与路径，不包含密钥）" FontSize="9.5" Margin="0,0,0,12" />
                    </StackPanel>
                    <TextBlock Text="保存到" FontSize="8" Foreground="{DynamicResource Subtle}" />
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource InnerBorder}"
                                Background="{DynamicResource Card}" Padding="10,7">
                            <TextBox x:Name="PbExpPath" FontSize="9" BorderThickness="0" Background="Transparent" />
                        </Border>
                        <Button Grid.Column="1" Content="浏览" Style="{StaticResource BtnSecondary}" Height="32"
                                Padding="14,0" FontSize="9" Margin="8,0,0,0" Click="OnPbExpBrowse" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <TextBlock x:Name="PbExpSize" Text="" FontSize="8.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Subtle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Style="{StaticResource BtnSecondary}" Height="32" Padding="16,0"
                                    FontSize="9" Click="OnPbExportClose" />
                            <Button Content="导出" Style="{StaticResource BtnPrimary}" Height="32" Padding="18,0"
                                    FontSize="9" Margin="8,0,0,0" Click="OnPbExportStart" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="PbExportProgress" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock x:Name="PbExpStage" Text="准备中…" FontSize="9" Foreground="{DynamicResource Muted}" />
                        <ProgressBar x:Name="PbExpBar" Height="6" Minimum="0" Maximum="100" Margin="0,8,0,0"
                                     Value="0" Foreground="{DynamicResource Accent}" Background="{DynamicResource InnerBorder}" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="PbExpPercent" Text="0%" FontSize="8.5" Foreground="{DynamicResource Subtle}" />
                            <Button Content="取消导出" Style="{StaticResource BtnCompact}" Height="26" Padding="10,0"
                                    FontSize="8.5" HorizontalAlignment="Right" Click="OnPbExpCancel" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="PbExportDone" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="导出完成" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Success}" />
                        <TextBlock x:Name="PbExpDonePath" Text="" FontSize="8.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Muted}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="在文件夹中显示" Style="{StaticResource BtnSecondary}" Height="30" Padding="14,0"
                                    FontSize="9" Click="OnPbExpShowFolder" />
                            <Button Content="关闭" Style="{StaticResource BtnPrimary}" Height="30" Padding="16,0"
                                    FontSize="9" Margin="8,0,0,0" Click="OnPbExportClose" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 恢复 -->
                <StackPanel x:Name="PbImportPanel" Visibility="Collapsed" Margin="26,22,26,22">
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="恢复项目" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                            <TextBlock Text="预览备份内容并选择写入方式，预检完成前不会修改项目。" FontSize="9" Margin="0,5,0,0"
                                       Foreground="{DynamicResource Muted}" />
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource BtnCompact}" Width="30" Height="30"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnPbImportClose" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource InnerBorder}"
                                Background="{DynamicResource Card}" Padding="10,7">
                            <TextBox x:Name="PbImpPath" FontSize="9" BorderThickness="0" Background="Transparent" />
                        </Border>
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource BtnSecondary}" Height="32"
                                Padding="14,0" FontSize="9" Margin="8,0,0,0" Click="OnPbImpBrowse" />
                    </Grid>
                    <TextBlock x:Name="PbImpCheck" Text="" FontSize="8.5" Margin="0,7,0,0" Foreground="{DynamicResource Success}" />
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="处理方式" FontSize="8" Foreground="{DynamicResource Subtle}" />
                        <RadioButton x:Name="PbImpModeNew" Content="导入为新项目（保留当前项目，使用新项目名称）"
                                     IsChecked="True" FontSize="9" Margin="0,6,0,4" GroupName="impMode" />
                        <RadioButton x:Name="PbImpModeMerge" Content="合并到现有项目（合并会话与文件，按冲突规则处理）"
                                     FontSize="9" GroupName="impMode" />
                    </StackPanel>
                    <TextBlock Text="新项目名称" FontSize="8" Margin="0,10,0,4" Foreground="{DynamicResource Subtle}" />
                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource InnerBorder}"
                            Background="{DynamicResource Card}" Padding="10,7">
                        <TextBox x:Name="PbImpName" FontSize="9" BorderThickness="0" Background="Transparent" />
                    </Border>
                    <TextBlock Text="目标目录" FontSize="8" Margin="0,9,0,4" Foreground="{DynamicResource Subtle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource InnerBorder}"
                                Background="{DynamicResource Card}" Padding="10,7">
                            <TextBox x:Name="PbImpDir" FontSize="9" BorderThickness="0" Background="Transparent" />
                        </Border>
                        <Button Grid.Column="1" Content="浏览" Style="{StaticResource BtnSecondary}" Height="32"
                                Padding="14,0" FontSize="9" Margin="8,0,0,0" Click="OnPbImpBrowseDir" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <TextBlock x:Name="PbImpInfo" Text="" FontSize="8.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Subtle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Style="{StaticResource BtnSecondary}" Height="32" Padding="16,0"
                                    FontSize="9" Click="OnPbImportClose" />
                            <Button Content="开始导入" Style="{StaticResource BtnPrimary}" Height="32" Padding="18,0"
                                    FontSize="9" Margin="8,0,0,0" Click="OnPbImportStart" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="PbImportProgress" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock x:Name="PbImpStage" Text="准备中…" FontSize="9" Foreground="{DynamicResource Muted}" />
                        <ProgressBar x:Name="PbImpBar" Height="6" Minimum="0" Maximum="100" Margin="0,8,0,0"
                                     Value="0" Foreground="{DynamicResource Accent}" Background="{DynamicResource InnerBorder}" />
                    </StackPanel>
                    <StackPanel x:Name="PbImportDone" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="已导入，重启实例后可见" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Success}" />
                        <TextBlock x:Name="PbImpDoneText" Text="" FontSize="8.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Muted}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="稍后" Style="{StaticResource BtnSecondary}" Height="30" Padding="14,0"
                                    FontSize="9" Click="OnPbImportClose" />
                            <Button Content="立即重启实例" Style="{StaticResource BtnPrimary}" Height="30" Padding="16,0"
                                    FontSize="9" Margin="8,0,0,0" Click="OnPbRestartInstance" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Grid>
        </Border>
    </Border>
</Window>

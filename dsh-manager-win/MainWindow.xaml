                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="9"
                                                        Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                                                    <Path Width="15" Height="15" Data="{StaticResource Icon.folder}"
                                                          Style="{StaticResource IconPath}" Stroke="{DynamicResource Accent}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="11,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold"

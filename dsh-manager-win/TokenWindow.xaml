<Window x:Class="DshManager.TokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="查看 Token" Width="720" Height="520" MinWidth="520" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource CardSolid}" FontFamily="{StaticResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource CardSolid}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{DynamicResource AppRadius}">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="OnDrag">
                <TextBlock x:Name="TitleText" Text="查看 Token" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Width="28" Height="28" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Click="OnClose">
                    <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource Muted}" />
                </Button>
            </Grid>

            <TextBlock Grid.Row="1" Margin="0,8,0,12" FontSize="9"
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                       Text="下面是该实例的访问地址、本次启动的 token 与认证 cookie。可以鼠标选中，也可以直接点「复制全部」。" />

            <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource App}"
                    BorderBrush="{DynamicResource InnerBorder}" BorderThickness="1" Padding="2">
                <TextBox x:Name="BodyText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="Transparent" BorderThickness="0" Padding="10"
                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                         Foreground="{DynamicResource Text}" />
            </Border>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText" FontSize="9" VerticalAlignment="Center"
                           Foreground="{DynamicResource Subtle}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="复制全部" Style="{StaticResource BtnSecondary}" Height="34" Padding="18,0"
                            Click="OnCopyAll" />
                    <Button Content="关闭" Style="{StaticResource BtnPrimary}" Height="34" Padding="18,0"
                            Margin="8,0,0,0" Click="OnClose" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

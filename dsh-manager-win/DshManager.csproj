<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DshManager</AssemblyName>
    <RootNamespace>DshManager</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
    <Product>DeepSeek Harness 管理器</Product>
    <AssemblyTitle>DeepSeek Harness 管理器</AssemblyTitle>
    <Company>cuteG41cute</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- 桌面窗口（DSH 会话窗口）也在这个工程里：整个 Windows 版就是一个产品、一个包 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>

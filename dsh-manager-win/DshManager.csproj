<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DshManager</AssemblyName>
    <RootNamespace>DshManager</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 图标沿用旧启动器的黑色鲸鱼（exe / 快捷方式 / 任务栏都用它） -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>3.0.2</Version>
    <FileVersion>3.0.2.0</FileVersion>
    <AssemblyVersion>3.0.2.0</AssemblyVersion>
    <Product>DeepSeek Harness 管理器</Product>
    <AssemblyTitle>DeepSeek Harness 管理器</AssemblyTitle>
    <Company>cuteG41cute</Company>
  </PropertyGroup>

  <ItemGroup>
    <!-- 侧栏品牌位用的鲸鱼图；app.ico 同时给窗口 Icon 用 -->
    <Resource Include="Assets\whale.png" />
    <EmbeddedResource Include="web\preview-tools.js" />
    <EmbeddedResource Include="web\image-zoom.js" />
    <EmbeddedResource Include="web\image-pan.js" />
    <EmbeddedResource Include="web\file-dragout.js" />
    <EmbeddedResource Include="web\preview-menu.js" />
    <EmbeddedResource Include="web\folder-drop.js" />
    <EmbeddedResource Include="web\text-menu.js" />
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 桌面窗口（DSH 会话窗口）也在这个工程里：整个 Windows 版就是一个产品、一个包 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>

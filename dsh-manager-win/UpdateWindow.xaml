<Window x:Class="DshManager.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="更新 dsh" Width="520" Height="470"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource CardSolid}" FontFamily="{StaticResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource CardSolid}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{DynamicResource AppRadius}">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnDrag">
                <TextBlock Text="更新 dsh" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" />
                <Button HorizontalAlignment="Right" Width="28" Height="28" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Click="OnClose">
                    <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource Muted}" />
                </Button>
            </Grid>

            <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,8,0,16" FontSize="10"
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />

            <!-- dsh 版本：抽屉式下拉 -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="dsh 版本" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,6"
                           Foreground="{DynamicResource Muted}" />
                <ComboBox x:Name="DshBox" Height="36" FontSize="11" Padding="10,0"
                          VerticalContentAlignment="Center"
                          Background="{DynamicResource App}" Foreground="{DynamicResource Text}"
                          BorderBrush="{DynamicResource InnerBorder}" />
                <TextBlock x:Name="DshHint" FontSize="9" Margin="2,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Subtle}" />
            </StackPanel>

            <!-- Node 版本：抽屉式下拉 -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="Node 版本（便携，可选）" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,6"
                           Foreground="{DynamicResource Muted}" />
                <ComboBox x:Name="NodeBox" Height="36" FontSize="11" Padding="10,0"
                          VerticalContentAlignment="Center"
                          Background="{DynamicResource App}" Foreground="{DynamicResource Text}"
                          BorderBrush="{DynamicResource InnerBorder}" />
                <TextBlock x:Name="NodeHint" FontSize="9" Margin="2,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Subtle}" />
            </StackPanel>

            <TextBlock x:Name="HintText" Grid.Row="4" Margin="2,14,2,0" FontSize="9"
                       TextWrapping="Wrap" Foreground="{DynamicResource Subtle}" />

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消" Style="{StaticResource BtnSecondary}" Height="34" Padding="18,0"
                        Click="OnClose" />
                <Button x:Name="ApplyBtn" Content="应用" Style="{StaticResource BtnPrimary}"
                        Height="34" Padding="18,0" Margin="8,0,0,0" Click="OnApply" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

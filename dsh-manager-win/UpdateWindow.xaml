<Window x:Class="DshManager.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="更新 dsh" Width="540" Height="500"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource CardSolid}" FontFamily="{StaticResource UiFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource CardSolid}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{DynamicResource AppRadius}">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 + 加载指示 -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="更新 dsh" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <Grid x:Name="Spinner" Width="18" Height="18" Margin="12,0,0,0"
                          VerticalAlignment="Center" Visibility="Collapsed">
                        <!-- 底圈：淡灰整圆（抄 DSH 自己那个转圈的样子） -->
                        <Ellipse Width="14" Height="14" Stroke="{DynamicResource Subtle}" StrokeThickness="2"
                                 Opacity="0.45" />
                        <!-- 高亮弧：一段 110° 的 Accent 弧，跟着定时器旋转 -->
                        <Path Data="M 9,3.2 A 5.8,5.8 0 0 1 13.4,13.2"
                              Stroke="{DynamicResource Accent}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="LoadingText" Text="正在获取版本列表…" FontSize="10"
                               Margin="8,1,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Muted}" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Width="28" Height="28" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Click="OnClose">
                    <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource Muted}" />
                </Button>
            </Grid>

            <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,10,0,16" FontSize="10"
                       TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />

            <!-- dsh 版本 -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="dsh 版本" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,6"
                           Foreground="{DynamicResource Muted}" />
                <ComboBox x:Name="DshBox" Height="36" FontSize="11" Padding="10,0"
                          VerticalContentAlignment="Center" IsEnabled="False"
                          Background="{DynamicResource App}" Foreground="{DynamicResource Text}"
                          BorderBrush="{DynamicResource InnerBorder}" />
                <TextBlock x:Name="DshHint" FontSize="9" Margin="2,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Subtle}" Text="等待版本列表…" />
            </StackPanel>

            <!-- Node 版本 -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="Node 版本（便携，可选）" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,6"
                           Foreground="{DynamicResource Muted}" />
                <ComboBox x:Name="NodeBox" Height="36" FontSize="11" Padding="10,0"
                          VerticalContentAlignment="Center" IsEnabled="False"
                          Background="{DynamicResource App}" Foreground="{DynamicResource Text}"
                          BorderBrush="{DynamicResource InnerBorder}" />
                <TextBlock x:Name="NodeHint" FontSize="9" Margin="2,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Subtle}" Text="等待版本列表…" />
            </StackPanel>

            <TextBlock x:Name="HintText" Grid.Row="4" Margin="2,14,2,0" FontSize="9"
                       TextWrapping="Wrap" Foreground="{DynamicResource Subtle}" />

            <!-- 底部：检查更新 / 取消 / 应用 -->
            <Grid Grid.Row="6" Margin="0,14,0,0">
                <Button x:Name="RefreshBtn" Content="检查更新" Style="{StaticResource BtnSecondary}"
                        Height="34" Padding="18,0" HorizontalAlignment="Left" Click="OnRefresh" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource BtnSecondary}" Height="34" Padding="18,0"
                            Click="OnClose" />
                    <Button x:Name="ApplyBtn" Content="应用" Style="{StaticResource BtnPrimary}"
                            Height="34" Padding="18,0" Margin="8,0,0,0" Click="OnApply" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

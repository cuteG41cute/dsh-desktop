# 运行时与临时目录（dsh harness 在工作目录生成的）
api/
skills/
logs/
.tmp/

# WebView2 用户数据与历史残留
dsh-desktop/user-data/
dsh-desktop/*.old.exe
*.old.exe

# 备份
DeepSeek Harness 检查点*.zip
# dsh-file-history 自动备份（改前检查点）：工作区 backup/ 是 dsh-desktop 仓库内容，
# 它的 .dsh-backup/ 不纳入版本控制（插件在仓库根之外，无法自动登记，故手工登记）。
/backup/.dsh-backup/

# 编辑器/系统
Thumbs.db
Desktop.ini
.DS_Store

# 共享插件/技能发布目录（harness 生成，dsh-api / dsh-desktop-detach 等）
share/

# 独立子项目（各自是独立 git 仓库）
dsh-time-stamp/

# Python cache
__pycache__/
*.pyc
